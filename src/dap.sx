val stdio      = use("std/stdio")
val string     = use("std/string")
val os         = use("std/os")
val allocators = use("std/allocators")
val json       = use("std/json")
val util       = use("util.sx")
val target     = use("target.sx")
val lldb       = use("lldb.sx")
val native     = use("native.sx")

extern (C, header) fn fgets(s: ref u8, size: i32, stream: ref void) ref u8 = "fgets"
extern (C, header) fn fread(ptr: ref void, size: usize, count: usize, stream: ref void) usize = "fread"
extern (C, header) fn fflush(stream: ref void) i32 = "fflush"

when posix {
    extern (C, header) fn getpid() i32 = "getpid"
}

type DapState = {
    arena: mut allocators.Arena
    seq: mut i64
    backend: mut ref u8
    compiler: mut ref u8
    program: mut ref u8
    program_set: mut bool
    args: mut list[ref u8]
    initialized: mut bool
    configured: mut bool
    started: mut bool
    exited: mut bool
    lldb_session: mut ref lldb.LldbSession
    native_session: mut ref native.NativeSession
    metadata: mut ref target.Target
    bp_files: mut list[ref u8]
    bp_lines: mut list[i64]
    stop_reason: mut ref u8
}

fn next_seq(s: mut ref DapState) i64 = trust {
    s.seq = s.seq + 1
    return s.seq
}

fn obj_add_str(b: json.JsonBuilder, obj: ref void, key: ref u8, value: ref u8) void = trust {
    json.object_add(obj, json.build_str(b, key), json.build_str(b, value))
}

fn obj_add_int(b: json.JsonBuilder, obj: ref void, key: ref u8, value: i64) void = trust {
    json.object_add(obj, json.build_str(b, key), json.build_int(b, value))
}

fn obj_add_bool(b: json.JsonBuilder, obj: ref void, key: ref u8, value: bool) void = trust {
    json.object_add(obj, json.build_str(b, key), json.build_bool(b, value))
}

fn obj_add_obj(b: json.JsonBuilder, obj: ref void, key: ref u8, value: ref void) void = trust {
    json.object_add(obj, json.build_str(b, key), value)
}


fn send_json(text: ref u8) void = trust {
    val len: i64 = string.len_raw(text)
    stdio.print("Content-Length: {d}\r\n\r\n{s}", {len, text})
    fflush(@stdout())
}

fn send_response(
    s: mut ref DapState,
    request_seq: i64,
    command: ref u8,
    success: bool,
    body: ref void
) void = trust {
    val b: json.JsonBuilder = json.builder_new()
    val root: ref void = json.build_object(b)
    obj_add_int(b, root, "seq", next_seq(s))
    obj_add_str(b, root, "type", "response")
    obj_add_int(b, root, "request_seq", request_seq)
    obj_add_bool(b, root, "success", success)
    obj_add_str(b, root, "command", command)
    if body != none {
        obj_add_obj(b, root, "body", body)
    }
    json.builder_set_root(b, root)
    val text: ref u8 = json.builder_to_string[allocators.Arena](s.arena, b)
    send_json(text)
    json.builder_free(b)
}

fn send_error(s: mut ref DapState, request_seq: i64, command: ref u8, message: ref u8) void = trust {
    val b: json.JsonBuilder = json.builder_new()
    val root: ref void = json.build_object(b)
    obj_add_int(b, root, "seq", next_seq(s))
    obj_add_str(b, root, "type", "response")
    obj_add_int(b, root, "request_seq", request_seq)
    obj_add_bool(b, root, "success", false)
    obj_add_str(b, root, "command", command)
    obj_add_str(b, root, "message", message)
    json.builder_set_root(b, root)
    val text: ref u8 = json.builder_to_string[allocators.Arena](s.arena, b)
    send_json(text)
    json.builder_free(b)
}

fn send_event(s: mut ref DapState, event_name: ref u8, body: ref void) void = trust {
    val b: json.JsonBuilder = json.builder_new()
    val root: ref void = json.build_object(b)
    obj_add_int(b, root, "seq", next_seq(s))
    obj_add_str(b, root, "type", "event")
    obj_add_str(b, root, "event", event_name)
    if body != none {
        obj_add_obj(b, root, "body", body)
    }
    json.builder_set_root(b, root)
    val text: ref u8 = json.builder_to_string[allocators.Arena](s.arena, b)
    send_json(text)
    json.builder_free(b)
}

fn send_stopped(s: mut ref DapState, reason: ref u8) void = trust {
    s.stop_reason = reason
    val b: json.JsonBuilder = json.builder_new()
    val body: ref void = json.build_object(b)
    obj_add_str(b, body, "reason", reason)
    obj_add_int(b, body, "threadId", 1)
    obj_add_bool(b, body, "allThreadsStopped", true)
    send_event(s, "stopped", body)
    json.builder_free(b)
}

fn send_exited(s: mut ref DapState, code: i64) void = trust {
    s.exited = true
    val b: json.JsonBuilder = json.builder_new()
    val body: ref void = json.build_object(b)
    obj_add_int(b, body, "exitCode", code)
    send_event(s, "exited", body)
    json.builder_free(b)
    val b2: json.JsonBuilder = json.builder_new()
    send_event(s, "terminated", none)
    json.builder_free(b2)
}

/// Read one DAP packet from stdin. Returns none on EOF.
fn read_packet() option[ref u8] = trust {
    val header: mut [4096]u8 = @zeroed
    val content_len: mut i64 = -1
    for {
        val p: ref u8 = fgets(@addr(header) as ref u8, 4096, @stdin())
        if p == none {
            return none
        }
        val line: ref u8 = @addr(header) as ref u8
        val n: i64 = string.len_raw(line)
        if n <= 2 {
            break
        }
        if string.raw_starts_with(line, "Content-Length:") {
            val num: ref u8 = @ptradd(line, 15)
            val v_opt = util.parse_i64(trim_raw(num))
            if v_opt is some v {
                content_len = v
            }
        }
    }
    if content_len < 0 {
        return none
    }
    val body: ref u8 = @alloc((content_len + 1) as usize) as ref u8
    @memset(body, 0, (content_len + 1) as usize)
    val got: usize = fread(body as ref void, 1, content_len as usize, @stdin())
    @store8(@ptradd(body, got as i64), 0)
    return some body
}

fn trim_raw(s: ref u8) ref u8 = trust {
    val n: i64 = string.len_raw(s)
    val start: mut i64 = 0
    val end: mut i64 = n
    for {
        if start >= end {
            break
        }
        val c: u8 = @load8(@ptradd(s, start))
        if c != 32 && c != 9 && c != 13 && c != 10 {
            break
        }
        start++
    }
    for {
        if end <= start {
            break
        }
        val c: u8 = @load8(@ptradd(s, end - 1))
        if c != 32 && c != 9 && c != 13 && c != 10 {
            break
        }
        end--
    }
    return util.copy_cstr_len(@ptradd(s, start), end - start)
}

fn find_compiler(explicit: ref u8) ref u8 = trust {
    if explicit != none && string.len_raw(explicit) > 0 {
        return explicit
    }
    val env1 = os.getenv("PHANTOM_COMPILER")
    if env1 != none && string.len_raw(env1) > 0 {
        return env1
    }
    if os.in_path("spectre-dev") {
        return "spectre-dev"
    }
    if os.in_path("spectre") {
        return "spectre"
    }
    if os.exists("../spectre/spectre-dev") {
        return "../spectre/spectre-dev"
    }
    return "spectre"
}

fn build_source(compiler: ref u8, source: ref u8) result[ref u8, ref u8] = trust {
    val base: mut ref u8 = util.basename(source)
    if string.raw_ends_with(base, ".sx") {
        base = util.copy_cstr_len(base, string.len_raw(base) - 3)
    }
    val out: ref u8 = @fmtalloc("/tmp/phantom-dap-{d}-{s}", {getpid(), base})
    val cmd: ref u8 = @fmtalloc(
        "{s} {s} -alt -no-single-flags -o {s} 2>&1",
        {compiler, source, out}
    )
    val res = os.exec(cmd)
    match res {
        err e => {
            return err @fmtalloc("could not run compiler '{s}': {s}", {compiler, e})
        }
        ok output => {
            if !os.exists(out) {
                return err @fmtalloc("build failed:\n{s}", {string.cstr(output)})
            }
        }
    }
    return ok out
}

fn load_metadata(arena: allocators.Arena, program: ref u8) result[ref target.Target, ref u8] = trust {
    return target.load(arena, program)
}

fn create_lldb(s: mut ref DapState, program: ref u8) bool = trust {
    val opt = lldb.new("lldb", program)
    match opt {
        err e => {
            stdio.eprint("phantom dap: {s}\n", {e})
            return false
        }
        ok sv => {
            s.lldb_session = sv
            return true
        }
    }
    return false
}

fn create_native(s: mut ref DapState, program: ref u8) bool = trust {
    val arena: allocators.Arena = allocators.Arena.new(64 * 1024 * 1024 as usize)?
    val opt = native.load(arena, program)
    match opt {
        err e => {
            stdio.eprint("phantom dap: {s}\n", {e})
            return false
        }
        ok sv => {
            s.native_session = sv
            s.native_session.redirect_stdout = true
            return true
        }
    }
    return false
}

fn apply_breakpoints_lldb(s: mut ref DapState) bool = trust {
    if s.lldb_session == none {
        return false
    }
    lldb.command(s.lldb_session, "breakpoint delete --force")
    val n: i64 = @len(s.bp_files) as i64
    val i: mut i64 = 0
    for {
        if i >= n {
            break
        }
        val f_opt = @get(s.bp_files, i as usize)
        val l_opt = @get(s.bp_lines, i as usize)
        if f_opt is some f {
            if l_opt is some line {
                lldb.breakpoint_file_line(s.lldb_session, f as ref u8, line as i64)
            }
        }
        i++
    }
    return true
}

fn clear_native_breakpoints(s: mut ref DapState) void = trust {
    if s.native_session == none {
        return
    }
    val n: i64 = @len(s.native_session.breakpoints) as i64
    val i: mut i64 = n - 1
    for {
        if i < 0 {
            break
        }
        val opt = @get(s.native_session.breakpoints, i as usize)
        if opt is some bp {
            native.delete_breakpoint(s.native_session, bp.id)
        }
        i--
    }
}

fn apply_breakpoints_native(s: mut ref DapState) void = trust {
    if s.native_session == none {
        return
    }
    clear_native_breakpoints(s)
    val n: i64 = @len(s.bp_files) as i64
    val i: mut i64 = 0
    for {
        if i >= n {
            break
        }
        val f_opt = @get(s.bp_files, i as usize)
        val l_opt = @get(s.bp_lines, i as usize)
        if f_opt is some f {
            if l_opt is some line {
            val addr_opt = target.line_address(s.metadata, f as ref u8, line as i64)
            if addr_opt is some addr {
                native.add_breakpoint(s.native_session, addr, f as ref u8, "source")
            }
            }
        }
        i++
    }
}

fn replace_file_breakpoints(
    s: mut ref DapState,
    file: ref u8,
    lines: list[i64]
) void = trust {
    val new_files: mut list[ref u8] = @listalloc[allocators.HeapAllocator, ref u8](util.heap())?
    val new_lines: mut list[i64] = @listalloc[allocators.HeapAllocator, i64](util.heap())?
    val n: i64 = @len(s.bp_files) as i64
    val i: mut i64 = 0
    for {
        if i >= n {
            break
        }
        val f_opt = @get(s.bp_files, i as usize)
        val l_opt = @get(s.bp_lines, i as usize)
        if f_opt is some f {
            if l_opt is some line {
                if !string.str_eql(f as ref u8, file) {
                    @append(new_files, f as ref u8)
                    @append(new_lines, line as i64)
                }
            }
        }
        i++
    }
    for line in lines {
        @append(new_files, util.copy_cstr(file))
        @append(new_lines, line)
    }
    s.bp_files = new_files
    s.bp_lines = new_lines
    if string.str_eql(s.backend, "lldb") {
        apply_breakpoints_lldb(s)
    } else {
        apply_breakpoints_native(s)
    }
}

fn handle_initialize(s: mut ref DapState, req_seq: i64) void = trust {
    val b: json.JsonBuilder = json.builder_new()
    val body: ref void = json.build_object(b)
    obj_add_bool(b, body, "supportsConfigurationDoneRequest", true)
    obj_add_bool(b, body, "supportsFunctionBreakpoints", true)
    obj_add_bool(b, body, "supportsEvaluateForHovers", true)
    obj_add_bool(b, body, "supportsSetVariable", false)
    obj_add_bool(b, body, "supportsTerminateRequest", false)
    send_response(s, req_seq, "initialize", true, body)
    json.builder_free(b)
    s.initialized = true
    send_event(s, "initialized", none)
}

fn handle_launch(s: mut ref DapState, req_seq: i64, args: ref void) void = trust {
    val program: mut ref u8 = s.program
    val prog_args: mut list[ref u8] = @listalloc[allocators.HeapAllocator, ref u8](util.heap())?
    if args != none {
        val p_opt = json.obj_get_str(args, "program")
        if p_opt is some p {
            program = p as ref u8
        }
        val a_opt = json.obj_get(args, "args")
        if a_opt is some arr {
            val alen: i64 = json.arr_len(arr as ref void) as i64
            val ai: mut i64 = 0
            for {
                if ai >= alen {
                    break
                }
                val el = json.arr_get(arr as ref void, ai as usize)
                if el is some ev {
                    if json.val_is_str(ev as ref void) {
                        @append(prog_args, json.val_get_str(ev as ref void))
                    }
                }
                ai++
            }
        }
    }
    if string.len_raw(program) == 0 {
        send_error(s, req_seq, "launch", "no program specified (pass --program or use a launch request)")
        return
    }
    if string.raw_ends_with(program, ".sx") {
        val built = build_source(find_compiler(s.compiler), program)
        match built {
            err e => {
                send_error(s, req_seq, "launch", e)
                return
            }
            ok pv => {
                program = pv
            }
        }
    }
    s.program = program
    s.args = prog_args
    s.program_set = true

    val arena: allocators.Arena = allocators.Arena.new(64 * 1024 * 1024 as usize)?
    val meta_opt = load_metadata(arena, program)
    match meta_opt {
        err e => {
            send_error(s, req_seq, "launch", e)
            return
        }
        ok mv => {
            s.metadata = mv
        }
    }

    if string.str_eql(s.backend, "lldb") {
        if !create_lldb(s, program) {
            send_error(s, req_seq, "launch", "could not start LLDB")
            return
        }
    } else {
        if !create_native(s, program) {
            send_error(s, req_seq, "launch", "could not load native debug info")
            return
        }
    }
    send_response(s, req_seq, "launch", true, none)
}

fn handle_set_breakpoints(s: mut ref DapState, req_seq: i64, args: ref void) void = trust {
    val file: mut ref u8 = ""
    if args != none {
        val src_opt = json.obj_get(args, "source")
        if src_opt is some src {
            val path_opt = json.obj_get_str(src as ref void, "path")
            if path_opt is some p {
                file = p as ref u8
            }
        }
    }
    val lines: mut list[i64] = @listalloc[allocators.HeapAllocator, i64](util.heap())?
    if args != none {
        val bps_opt = json.obj_get(args, "breakpoints")
        if bps_opt is some arr {
            val alen: i64 = json.arr_len(arr as ref void) as i64
            val ai: mut i64 = 0
            for {
                if ai >= alen {
                    break
                }
                val el = json.arr_get(arr as ref void, ai as usize)
                if el is some ev {
                    val line_opt = json.obj_get_int(ev as ref void, "line")
                    if line_opt is some line {
                        @append(lines, line)
                    }
                }
                ai++
            }
        }
    }
    replace_file_breakpoints(s, file, lines)

    val b: json.JsonBuilder = json.builder_new()
    val body: ref void = json.build_object(b)
    val arr: ref void = json.build_array(b)
    val id: mut i64 = 1
    for line in lines {
        val bp: ref void = json.build_object(b)
        obj_add_bool(b, bp, "verified", true)
        obj_add_int(b, bp, "line", line)
        obj_add_int(b, bp, "id", id)
        obj_add_obj(b, arr, "", bp)
        // DAP arrays need an append, not object_add. Rebuild below.
        id++
    }
    // Build a proper array using array_append.
    val arr2: ref void = json.build_array(b)
    for line in lines {
        val bp2: ref void = json.build_object(b)
        obj_add_bool(b, bp2, "verified", true)
        obj_add_int(b, bp2, "line", line)
        obj_add_int(b, bp2, "id", line)
        json.array_append(arr2, bp2)
    }
    obj_add_obj(b, body, "breakpoints", arr2)
    send_response(s, req_seq, "setBreakpoints", true, body)
    json.builder_free(b)
}

fn handle_set_function_breakpoints(s: mut ref DapState, req_seq: i64, args: ref void) void = trust {
    if args != none && s.lldb_session != none {
        val bps_opt = json.obj_get(args, "breakpoints")
        if bps_opt is some arr {
            val alen: i64 = json.arr_len(arr as ref void) as i64
            val ai: mut i64 = 0
            for {
                if ai >= alen {
                    break
                }
                val el = json.arr_get(arr as ref void, ai as usize)
                if el is some ev {
                    val name_opt = json.obj_get_str(ev as ref void, "name")
                    if name_opt is some name {
                        val raw: ref u8 = target.function_raw(s.metadata, name as ref u8)
                        if string.len_raw(raw) > 0 {
                            lldb.breakpoint_symbol(s.lldb_session, raw)
                        }
                    }
                }
                ai++
            }
        }
    } elif args != none && s.native_session != none {
        val bps_opt = json.obj_get(args, "breakpoints")
        if bps_opt is some arr {
            val alen: i64 = json.arr_len(arr as ref void) as i64
            val ai: mut i64 = 0
            for {
                if ai >= alen {
                    break
                }
                val el = json.arr_get(arr as ref void, ai as usize)
                if el is some ev {
                    val name_opt = json.obj_get_str(ev as ref void, "name")
                    if name_opt is some name {
                        val addr_opt = target.function_address(s.metadata, name as ref u8)
                        if addr_opt is some addr {
                            val raw: ref u8 = target.function_raw(s.metadata, name as ref u8)
                            native.add_breakpoint(s.native_session, addr, raw, "function")
                        }
                    }
                }
                ai++
            }
        }
    }
    send_response(s, req_seq, "setFunctionBreakpoints", true, none)
}

fn handle_configuration_done(s: mut ref DapState, req_seq: i64) void = trust {
    send_response(s, req_seq, "configurationDone", true, none)
    s.configured = true
    start_program(s)
}

fn start_program(s: mut ref DapState) void = trust {
    if s.started {
        return
    }
    s.started = true
    if string.str_eql(s.backend, "lldb") {
        lldb.run(s.lldb_session, s.args)
        if s.lldb_session.exited {
            send_exited(s, s.lldb_session.exit_code)
        } else {
            send_stopped(s, "breakpoint")
        }
    } else {
        val lr = native.launch(s.native_session, s.args)
        match lr {
            err e => {
                send_event_error(s, "launch", e)
                return
            }
            ok _ => {
                native.cont(s.native_session)
                if s.native_session.exited {
                    send_exited(s, s.native_session.exit_code)
                } else {
                    send_stopped(s, "breakpoint")
                }
            }
        }
    }
}

fn send_event_error(s: mut ref DapState, source: ref u8, message: ref u8) void = trust {
    val b: json.JsonBuilder = json.builder_new()
    val body: ref void = json.build_object(b)
    obj_add_str(b, body, "category", "stderr")
    obj_add_str(b, body, "output", @fmtalloc("phantom: {s}: {s}\n", {source, message}))
    send_event(s, "output", body)
    json.builder_free(b)
}

fn handle_threads(s: mut ref DapState, req_seq: i64) void = trust {
    val b: json.JsonBuilder = json.builder_new()
    val body: ref void = json.build_object(b)
    val arr: ref void = json.build_array(b)
    val th: ref void = json.build_object(b)
    obj_add_int(b, th, "id", 1)
    obj_add_str(b, th, "name", "main")
    json.array_append(arr, th)
    obj_add_obj(b, body, "threads", arr)
    send_response(s, req_seq, "threads", true, body)
    json.builder_free(b)
}

fn handle_continue(s: mut ref DapState, req_seq: i64) void = trust {
    val b: json.JsonBuilder = json.builder_new()
    val body: ref void = json.build_object(b)
    obj_add_bool(b, body, "allThreadsContinued", true)
    send_response(s, req_seq, "continue", true, body)
    json.builder_free(b)
    if string.str_eql(s.backend, "lldb") {
        lldb.cont(s.lldb_session)
        if s.lldb_session.exited {
            send_exited(s, s.lldb_session.exit_code)
        } else {
            send_stopped(s, "breakpoint")
        }
    } else {
        val cr = native.cont(s.native_session)
        match cr {
            err e => {
                send_event_error(s, "continue", e)
            }
            ok _ => {
                if s.native_session.exited {
                    send_exited(s, s.native_session.exit_code)
                } else {
                    send_stopped(s, "breakpoint")
                }
            }
        }
    }
}

fn handle_step(s: mut ref DapState, req_seq: i64, command: ref u8) void = trust {
    if !string.str_eql(s.backend, "lldb") {
        send_error(s, req_seq, command, "source-level stepping is not implemented in the native backend")
        return
    }
    if string.str_eql(command, "next") {
        lldb.next(s.lldb_session)
    } elif string.str_eql(command, "stepIn") {
        lldb.step(s.lldb_session)
    } else {
        lldb.finish(s.lldb_session)
    }
    send_response(s, req_seq, command, true, none)
    if s.lldb_session.exited {
        send_exited(s, s.lldb_session.exit_code)
    } else {
        send_stopped(s, "step")
    }
}

fn handle_stack_trace(s: mut ref DapState, req_seq: i64) void = trust {
    val b: json.JsonBuilder = json.builder_new()
    val body: ref void = json.build_object(b)
    val arr: ref void = json.build_array(b)
    if string.str_eql(s.backend, "lldb") && s.lldb_session != none {
        val frames: list[ref lldb.LldbFrame] = lldb.parse_frames(s.lldb_session.last_output)
        for f in frames {
            val fr: ref void = json.build_object(b)
            obj_add_int(b, fr, "id", f.index)
            obj_add_str(b, fr, "name", f.function_display)
            obj_add_int(b, fr, "line", f.line)
            obj_add_int(b, fr, "column", f.column)
            obj_add_str(b, fr, "instructionPointerReference", @fmtalloc("0x{x}", {f.address}))
            if string.len_raw(f.file) > 0 {
                val src: ref void = json.build_object(b)
                obj_add_str(b, src, "name", util.basename(f.file))
                obj_add_str(b, src, "path", f.file)
                obj_add_obj(b, fr, "source", src)
            }
            json.array_append(arr, fr)
        }
    } elif s.native_session != none && s.native_session.stopped {
        val fr: ref void = json.build_object(b)
        obj_add_int(b, fr, "id", 0)
        obj_add_str(b, fr, "name", native.current_function_name(s.native_session))
        val loc: ref u8 = native.current_location(s.native_session)
        val colon: i64 = last_colon(loc)
        if colon > 0 {
            val line_opt = util.parse_i64(@ptradd(loc, colon + 1))
            if line_opt is some line {
                obj_add_int(b, fr, "line", line)
            }
            val file: ref u8 = util.copy_cstr_len(loc, colon)
            val src: ref void = json.build_object(b)
            obj_add_str(b, src, "name", util.basename(file))
            obj_add_str(b, src, "path", file)
            obj_add_obj(b, fr, "source", src)
        }
        obj_add_str(b, fr, "instructionPointerReference", @fmtalloc("0x{x}", {s.native_session.regs.rip}))
        json.array_append(arr, fr)
    }
    obj_add_obj(b, body, "stackFrames", arr)
    obj_add_int(b, body, "totalFrames", json.arr_len(arr) as i64)
    send_response(s, req_seq, "stackTrace", true, body)
    json.builder_free(b)
}

fn handle_scopes(s: mut ref DapState, req_seq: i64) void = trust {
    val b: json.JsonBuilder = json.builder_new()
    val body: ref void = json.build_object(b)
    val arr: ref void = json.build_array(b)
    val sc: ref void = json.build_object(b)
    obj_add_str(b, sc, "name", "Locals")
    obj_add_int(b, sc, "variablesReference", 1001)
    obj_add_bool(b, sc, "expensive", false)
    json.array_append(arr, sc)
    obj_add_obj(b, body, "scopes", arr)
    send_response(s, req_seq, "scopes", true, body)
    json.builder_free(b)
}

fn handle_variables(s: mut ref DapState, req_seq: i64) void = trust {
    val b: json.JsonBuilder = json.builder_new()
    val body: ref void = json.build_object(b)
    val arr: ref void = json.build_array(b)
    if string.str_eql(s.backend, "lldb") && s.lldb_session != none {
        val vars: list[ref lldb.LldbVar] = lldb.parse_variables(lldb.clean_output(lldb.frame_variables(s.lldb_session)))
        for v in vars {
            val vr: ref void = json.build_object(b)
            obj_add_str(b, vr, "name", v.name)
            obj_add_str(b, vr, "value", v.value)
            obj_add_str(b, vr, "type", v.type_name)
            obj_add_int(b, vr, "variablesReference", 0)
            json.array_append(arr, vr)
        }
    } elif s.native_session != none && s.native_session.current_function != none {
        for v in s.native_session.current_function.variables {
            val vr2: ref void = json.build_object(b)
            obj_add_str(b, vr2, "name", v.source_name)
            obj_add_str(b, vr2, "value", native.read_expression(s.native_session, v.source_name))
            obj_add_str(b, vr2, "type", native.type_name(s.native_session, v.type_off))
            obj_add_int(b, vr2, "variablesReference", 0)
            json.array_append(arr, vr2)
        }
    }
    obj_add_obj(b, body, "variables", arr)
    send_response(s, req_seq, "variables", true, body)
    json.builder_free(b)
}

fn handle_evaluate(s: mut ref DapState, req_seq: i64, args: ref void) void = trust {
    val expr: mut ref u8 = ""
    if args != none {
        val e_opt = json.obj_get_str(args, "expression")
        if e_opt is some e {
            expr = e as ref u8
        }
    }
    val result: mut ref u8 = ""
    if string.str_eql(s.backend, "lldb") && s.lldb_session != none {
        val rewritten: ref u8 = lldb.rewrite_expression(s.lldb_session, expr)
        result = lldb.clean_output(lldb.expression(s.lldb_session, rewritten))
    } elif s.native_session != none {
        result = native.read_expression(s.native_session, expr)
    }
    if string.len_raw(result) == 0 {
        send_error(s, req_seq, "evaluate", "expression could not be evaluated")
        return
    }
    val b: json.JsonBuilder = json.builder_new()
    val body: ref void = json.build_object(b)
    obj_add_str(b, body, "result", result)
    obj_add_int(b, body, "variablesReference", 0)
    send_response(s, req_seq, "evaluate", true, body)
    json.builder_free(b)
}

fn handle_disconnect(s: mut ref DapState, req_seq: i64) void = trust {
    if s.lldb_session != none {
        lldb.quit(s.lldb_session)
    }
    if s.native_session != none {
        native.quit(s.native_session)
    }
    send_response(s, req_seq, "disconnect", true, none)
}

fn last_colon(s: ref u8) i64 = trust {
    val n: i64 = string.len_raw(s)
    val i: mut i64 = n - 1
    for {
        if i < 0 {
            break
        }
        if @load8(@ptradd(s, i)) == 58 {
            return i
        }
        i--
    }
    return -1
}

fn dispatch(s: mut ref DapState, packet: ref u8) void = trust {
    val doc_opt = json.parse(packet)
    val doc: mut json.JsonDoc = {ptr: none}
    if doc_opt is some dv {
        doc = dv as json.JsonDoc
    } else {
        return
    }
    val root: ref void = json.doc_root(doc)
    if !json.val_is_object(root) {
        json.doc_free(doc)
        return
    }
    val cmd_opt = json.obj_get_str(root, "command")
    val seq_opt = json.obj_get_int(root, "seq")
    val cmd: mut ref u8 = "unknown"
    if cmd_opt is some c {
        cmd = c as ref u8
    }
    val req_seq: mut i64 = 0
    if seq_opt is some q {
        req_seq = q
    }
    val args_opt = json.obj_get(root, "arguments")
    val args: mut ref void = none
    if args_opt is some a {
        args = a as ref void
    }

    if string.str_eql(cmd, "initialize") {
        handle_initialize(s, req_seq)
    } elif string.str_eql(cmd, "launch") {
        handle_launch(s, req_seq, args)
    } elif string.str_eql(cmd, "setBreakpoints") {
        handle_set_breakpoints(s, req_seq, args)
    } elif string.str_eql(cmd, "setFunctionBreakpoints") {
        handle_set_function_breakpoints(s, req_seq, args)
    } elif string.str_eql(cmd, "configurationDone") {
        handle_configuration_done(s, req_seq)
    } elif string.str_eql(cmd, "threads") {
        handle_threads(s, req_seq)
    } elif string.str_eql(cmd, "continue") {
        handle_continue(s, req_seq)
    } elif string.str_eql(cmd, "next") || string.str_eql(cmd, "stepIn") ||
    string.str_eql(cmd, "stepOut") {
        handle_step(s, req_seq, cmd)
    } elif string.str_eql(cmd, "stackTrace") {
        handle_stack_trace(s, req_seq)
    } elif string.str_eql(cmd, "scopes") {
        handle_scopes(s, req_seq)
    } elif string.str_eql(cmd, "variables") {
        handle_variables(s, req_seq)
    } elif string.str_eql(cmd, "evaluate") {
        handle_evaluate(s, req_seq, args)
    } elif string.str_eql(cmd, "disconnect") {
        handle_disconnect(s, req_seq)
    } elif string.str_eql(cmd, "setExceptionBreakpoints") ||
    string.str_eql(cmd, "setVariable") || string.str_eql(cmd, "source") {
        send_response(s, req_seq, cmd, true, none)
    } else {
        send_error(s, req_seq, cmd, @fmtalloc("unsupported request '{s}'", {cmd}))
    }
    json.doc_free(doc)
}

/// Run the DAP server on stdin/stdout.
pub fn run(
    compiler: ref u8,
    backend: ref u8,
    program_override: ref u8,
    initial_args: list[ref u8]
) i32 = trust {
    val s: mut ref DapState = @alloc(@sizeof(DapState)) as ref DapState
    @memset(s, 0, @sizeof(DapState) as usize)
    s.arena = allocators.Arena.new(64 * 1024 * 1024 as usize)?
    s.seq = 0
    s.backend = backend
    s.compiler = compiler
    s.program = program_override
    s.program_set = string.len_raw(program_override) > 0
    s.args = initial_args
    s.initialized = false
    s.configured = false
    s.started = false
    s.exited = false
    s.lldb_session = none
    s.native_session = none
    s.metadata = none
    s.bp_files = @listalloc[allocators.HeapAllocator, ref u8](util.heap())?
    s.bp_lines = @listalloc[allocators.HeapAllocator, i64](util.heap())?
    s.stop_reason = "breakpoint"

    for {
        val pkt_opt = read_packet()
        if pkt_opt is none {
            break
        }
        val pkt: mut ref u8 = none
        if pkt_opt is some pv {
            pkt = pv as ref u8
        }
        dispatch(s, pkt)
        if s.exited {
            break
        }
    }
    if s.lldb_session != none {
        lldb.quit(s.lldb_session)
    }
    if s.native_session != none {
        native.quit(s.native_session)
    }
    return 0
}
