/// Tiny process/pipe helpers used to drive LLDB and native ptrace sessions.
///
/// (C) Navid Momtahen - 2026
/// SPDX-License-Identifier: GPL-3.0-only

val util       = use("util.sx")

when posix {
    extern "sys/wait.h"
    extern "signal.h"
    extern (C, header) fn pipe(fds: ref i32) i32 = "pipe"
    extern (C, header) fn fork() i32 = "fork"
    extern (C, header) fn dup2(oldfd: i32, newfd: i32) i32 = "dup2"
    extern (C, header) fn close(fd: i32) i32 = "close"
    extern (C, header) fn execvp(file: ref u8, argv: ref ref u8) i32 = "execvp"
    extern (C, header) fn _exit(code: i32) void = "_exit"
    extern (C, header) fn read(fd: i32, buf: ref void, count: usize) i64 = "read"
    extern (C, header) fn write(fd: i32, buf: ref void, count: usize) i64 = "write"
    extern (C, header) fn waitpid(pid: i32, status: ref i32, options: i32) i32 = "waitpid"
    extern (C, header) fn kill(pid: i32, sig: i32) i32 = "kill"
    extern (C, header) fn getpid() i32 = "getpid"
}

when windows {
    extern (C, header) fn GetCurrentProcessId() u32 = "GetCurrentProcessId"
    extern (C, header) fn getenv(name: ref u8) ref u8 = "getenv"
    extern (C, header) fn _pipe(fds: ref i32, size: u32, mode: i32) i32 = "_pipe"
    extern (C, header) fn _dup(fd: i32) i32 = "_dup"
    extern (C, header) fn _dup2(oldfd: i32, newfd: i32) i32 = "_dup2"
    extern (C, header) fn _close(fd: i32) i32 = "_close"
    extern (C, header) fn _read(fd: i32, buf: ref void, count: u32) i32 = "_read"
    extern (C, header) fn _write(fd: i32, buf: ref void, count: u32) i32 = "_write"
    extern (C, header) fn _spawnvp(mode: i32, file: ref u8, argv: ref ref u8) i64 = "_spawnvp"
    extern (C, header) fn _cwait(status: ref i32, handle: i64, action: i32) i32 = "_cwait"
    extern (C, header) fn _exit(code: i32) void = "_exit"
    extern (C, header) fn TerminateProcess(handle: ref void, code: u32) bool = "TerminateProcess"
    extern (C, header) fn CloseHandle(handle: ref void) bool = "CloseHandle"
}

type PipeFds = {
    rd: i32
    wr: i32
}

pub type Child = {
    pid: mut i32
    in_fd: mut i32
    out_fd: mut i32
    process_handle: mut i64
    exited: mut bool
    status: mut i32
}

/// Return the current process id.
pub fn pid() i32 = trust {
    when windows {
        return GetCurrentProcessId() as i32
    }
    when posix {
        return getpid()
    }
    return 0
}

/// Spawn `argv[0]` with stdin/stdout/stderr connected to pipes.
pub fn spawn(argv: list[ref u8]) result[ref Child, ref u8] = trust {
    if @len(argv) == 0 {
        return err "empty command"
    }
    when windows {
        val in_fds: ref PipeFds = @alloc(@sizeof(PipeFds)) as ref PipeFds
        val out_fds: ref PipeFds = @alloc(@sizeof(PipeFds)) as ref PipeFds
        @memset(in_fds, 0, @sizeof(PipeFds) as usize)
        @memset(out_fds, 0, @sizeof(PipeFds) as usize)
        if _pipe(in_fds as ref i32, 65536 as u32, 0) != 0 {
            return err "pipe() failed"
        }
        if _pipe(out_fds as ref i32, 65536 as u32, 0) != 0 {
            _close(in_fds.rd)
            _close(in_fds.wr)
            return err "pipe() failed"
        }
        val saved0: i32 = _dup(0)
        val saved1: i32 = _dup(1)
        val saved2: i32 = _dup(2)
        if saved0 < 0 || saved1 < 0 || saved2 < 0 {
            _close(in_fds.rd)
            _close(in_fds.wr)
            _close(out_fds.rd)
            _close(out_fds.wr)
            return err "dup() failed"
        }
        _dup2(in_fds.rd, 0)
        _dup2(out_fds.wr, 1)
        _dup2(out_fds.wr, 2)
        val cmd: mut ref u8 = none
        val cmd_opt = @get(argv, 0)
        if cmd_opt is some cv {
            cmd = cv as ref u8
        }
        val argvp: ref ref u8 = @load(argv) as ref ref u8
        val handle: i64 = _spawnvp(1, cmd, argvp)
        _dup2(saved0, 0)
        _dup2(saved1, 1)
        _dup2(saved2, 2)
        _close(saved0)
        _close(saved1)
        _close(saved2)
        if handle < 0 {
            _close(in_fds.rd)
            _close(in_fds.wr)
            _close(out_fds.rd)
            _close(out_fds.wr)
            return err "spawn failed"
        }
        _close(in_fds.rd)
        _close(out_fds.wr)
        val c: mut ref Child = @alloc(@sizeof(Child)) as ref Child
        @memset(c, 0, @sizeof(Child) as usize)
        c.pid = 0
        c.in_fd = in_fds.wr
        c.out_fd = out_fds.rd
        c.process_handle = handle
        return ok c
    }
    when posix {
        val in_fds: ref PipeFds = @alloc(@sizeof(PipeFds)) as ref PipeFds
        val out_fds: ref PipeFds = @alloc(@sizeof(PipeFds)) as ref PipeFds
        @memset(in_fds, 0, @sizeof(PipeFds) as usize)
        @memset(out_fds, 0, @sizeof(PipeFds) as usize)
        if pipe(in_fds as ref i32) != 0 {
            return err "pipe() failed"
        }
        if pipe(out_fds as ref i32) != 0 {
            close(in_fds.rd)
            close(in_fds.wr)
            return err "pipe() failed"
        }
        val child_pid: i32 = fork()
        if child_pid < 0 {
            close(in_fds.rd)
            close(in_fds.wr)
            close(out_fds.rd)
            close(out_fds.wr)
            return err "fork() failed"
        }
        if child_pid == 0 {
            dup2(in_fds.rd, 0)
            dup2(out_fds.wr, 1)
            dup2(out_fds.wr, 2)
            close(in_fds.rd)
            close(in_fds.wr)
            close(out_fds.rd)
            close(out_fds.wr)
            val cmd: mut ref u8 = none
            val cmd_opt = @get(argv, 0)
            if cmd_opt is some cv {
                cmd = cv as ref u8
            }
            val argvp: ref ref u8 = @load(argv) as ref ref u8
            execvp(cmd, argvp)
            _exit(127)
        }
        close(in_fds.rd)
        close(out_fds.wr)
        val c: mut ref Child = @alloc(@sizeof(Child)) as ref Child
        @memset(c, 0, @sizeof(Child) as usize)
        c.pid = child_pid
        c.in_fd = in_fds.wr
        c.out_fd = out_fds.rd
        c.process_handle = 0
        return ok c
    }
    return err "unsupported platform"
}

/// Write all bytes to a file descriptor.
pub fn write_all(fd: i32, data: ref u8, len: i64) bool = trust {
    if len <= 0 {
        return true
    }
    val off: mut i64 = 0
    for {
        if off >= len {
            break
        }
        when windows {
            val nw: i64 = _write(fd, @ptradd(data, off), (len - off) as u32) as i64
            if nw <= 0 {
                return false
            }
            off += nw
        }
        when posix {
            val n: i64 = write(fd, @ptradd(data, off), (len - off) as usize)
            if n <= 0 {
                return false
            }
            off += n
        }
    }
    return true
}

/// Read one byte. Returns 1 on success, 0 on EOF and -1 on error.
pub fn read_byte(fd: i32, out: ref u8) i32 = trust {
    when windows {
        return _read(fd, out as ref void, 1 as u32)
    }
    when posix {
        return read(fd, out as ref void, 1) as i32
    }
    return -1
}

/// Read from `fd` until `marker` appears. The marker is included in the result.
pub fn read_until(fd: i32, marker: ref u8, cap: i64) ref u8 = trust {
    val limit: mut i64 = cap
    if limit <= 0 {
        limit = 1048576
    }
    val buf: ref u8 = @alloc((limit + 1) as usize) as ref u8
    @memset(buf, 0, (limit + 1) as usize)
    val mlen: i64 = util.len_raw[_](marker)
    val n: mut i64 = 0
    val found: mut bool = false
    for {
        if n >= limit {
            break
        }
        val ch: mut u8 = 0
        val rc: i32 = read_byte(fd, @addr(ch))
        if rc <= 0 {
            break
        }
        @store8(@ptradd(buf, n), ch)
        n++
        if n >= mlen {
            val matched: mut bool = true
            val i: mut i64 = 0
            for {
                if i >= mlen {
                    break
                }
                if @load8(@ptradd(buf, n - mlen + i)) != @load8(@ptradd(marker, i)) {
                    matched = false
                    break
                }
                i++
            }
            if matched {
                found = true
                break
            }
        }
    }
    @store8(@ptradd(buf, n), 0)
    return buf
}

/// Read one line from `fd` into `buf`.
pub fn read_line(fd: i32, buf: ref u8, cap: i64) i64 = trust {
    val n: mut i64 = 0
    for {
        if n >= cap - 1 {
            break
        }
        val ch: mut u8 = 0
        val rc: i32 = read_byte(fd, @addr(ch))
        if rc <= 0 {
            break
        }
        @store8(@ptradd(buf, n), ch)
        n++
        if ch == 10 {
            break
        }
    }
    @store8(@ptradd(buf, n), 0)
    return n
}

/// Close a descriptor if it is valid.
pub fn close_fd(fd: i32) void = trust {
    if fd >= 0 {
        when windows {
            _close(fd)
        }
        when posix {
            close(fd)
        }
    }
}

/// Wait for a child process to change state.
when posix {
    pub fn wait_child(pid_in: i32) i32 = trust {
        val status: mut i32 = 0
        waitpid(pid_in, @addr(status), 0)
        return status
    }
}

when windows {
    pub fn wait_child(_: i32) i32 = trust {
        return 0
    }
}

/// Send a signal to a child process.
when posix {
    pub fn signal(pid_in: i32, sig: i32) bool = trust {
        return kill(pid_in, sig) == 0
    }
}

when windows {
    pub fn signal(_: i32, _: i32) bool = trust {
        return false
    }
}

/// Quit a child, closing its pipes.
pub fn terminate(c: mut ref Child) void = trust {
    if c == none {
        return
    }
    when windows {
        if !c.exited && c.process_handle != 0 {
            TerminateProcess(@bitcast(c.process_handle, ref void), 9 as u32)
            val status: mut i32 = 0
            _cwait(@addr(status), c.process_handle, 0)
            CloseHandle(@bitcast(c.process_handle, ref void))
            c.process_handle = 0
            c.exited = true
        }
        close_fd(c.in_fd)
        close_fd(c.out_fd)
        c.in_fd = -1
        c.out_fd = -1
        return
    }
    when posix {
        if !c.exited {
            signal(c.pid, 9)
            wait_child(c.pid)
            c.exited = true
        }
        close_fd(c.in_fd)
        close_fd(c.out_fd)
        c.in_fd = -1
        c.out_fd = -1
    }
}

fn path_separator() u8 = trust {
    when windows {
        return 59
    }
    return 58
}

/// Find an executable in PATH. Returns none when not found.
pub fn find_executable(name: ref u8) bool = trust {
    val path_opt = env_get(c"PATH")
    val path: mut ref u8 = none
    if path_opt is some pv {
        path = pv as ref u8
    } else {
        return false
    }
    val n: i64 = util.len_raw[_](path)
    val start: mut i64 = 0
    val sep: u8 = path_separator()
    val i: mut i64 = 0
    for {
        if i > n {
            break
        }
        if i == n || @load8(@ptradd(path, i)) == sep {
            val dir_len: i64 = i - start
            if dir_len > 0 {
                val dir: ref u8 = util.copy_cstr_len(@ptradd(path, start), dir_len)
                val full: ref u8 = @fmtalloc("{s}/{s}", {dir, name})
                if file_executable(full) {
                    return true
                }
            }
            start = i + 1
        }
        i++
    }
    return false
}

fn env_get(name: ref u8) option[ref u8] = trust {
    val p: ref u8 = getenv(name)
    if p == none {
        return none
    }
    return some p
}

when posix {
    extern (C, header) fn getenv(name: ref u8) ref u8 = "getenv"
    extern (C, header) fn access(path: ref u8, mode: i32) i32 = "access"
}

when windows {
    extern (C, header) fn GetFileAttributesA(path: ref u8) u32 = "GetFileAttributesA"
}

fn file_executable(path: ref u8) bool = trust {
    when windows {
        return GetFileAttributesA(path) != 0xFFFFFFFF
    }
    when posix {
        return access(path, 1) == 0
    }
    return false
}
