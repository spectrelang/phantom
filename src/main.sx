val stdio      = use("std/stdio")
val os         = use("std/os")
val fs         = use("std/fs")
val allocators = use("std/allocators")
val util       = use("util.sx")
val target     = use("target.sx")
val cli        = use("cli.sx")
val dap        = use("dap.sx")
val demangle   = use("demangle.sx")
val elf        = use("elf.sx")
val dwarf      = use("dwarf.sx")

val VERSION: ref u8 = c"0.1.0"

fn arg_at(args: list[ref u8], index: i64) ref u8 = trust {
    val opt = @get(args, index as usize)
    if opt is some v {
        return v as ref u8
    }
    return c""
}

fn strip_sx_ext(name: ref u8) ref u8 = trust {
    if util.ends_with[_, _](name, ".sx") {
        return util.copy_cstr_len(name, util.len_or_zero(name) - 3)
    }
    return name
}

fn file_exists(path_in: ref u8) bool = trust {
    return os.exists(path_in)
}

fn find_compiler(explicit: ref u8) ref u8 = trust {
    if explicit != none && util.len_or_zero(explicit) > 0 {
        return explicit
    }
    val env1 = os.getenv(c"PHANTOM_COMPILER")
    if env1 != none && util.len_or_zero(env1) > 0 {
        return env1
    }
    val env2 = os.getenv(c"SPECTRE_COMPILER")
    if env2 != none && util.len_or_zero(env2) > 0 {
        return env2
    }
    if os.in_path(c"spectre-dev") {
        return c"spectre-dev"
    }
    if os.in_path(c"spectre") {
        return c"spectre"
    }
    if file_exists(c"../spectre/spectre-dev") {
        return c"../spectre/spectre-dev"
    }
    if file_exists(c"../spectre/spectre") {
        return c"../spectre/spectre"
    }
    return c"spectre"
}

fn build_source(compiler: ref u8, source: ref u8) result[ref u8, ref u8] = trust {
    val base: ref u8 = strip_sx_ext(util.basename[_](source))
    val tmp: ref u8 = fs.temp_dir_cstr()
    val out: ref u8 = @fmtalloc("{s}/phantom-{d}-{s}", {tmp, native_pid(), base})
    val cmd: ref u8 = @fmtalloc(
        "{s} {s} -alt -no-single-flags -o {s} 2>&1",
        {compiler, source, out}
    )
    val res = os.exec(cmd)
    match res {
        err e => {
            return err @fmtalloc("could not run compiler '{s}': {s}", {compiler, e})
        }
        ok output => {
            if !file_exists(out) {
                val text: ref u8 = output.ptr
                return err @fmtalloc("build failed:\n{s}", {text})
            }
        }
    }
    return ok out
}

fn native_pid() i32 = trust {
    return pid_via_os()
}

when posix {
    extern (C, header) fn getpid() i32 = "getpid"
}

when windows {
    extern (C, header) fn GetCurrentProcessId() u32 = "GetCurrentProcessId"
}

fn pid_via_os() i32 = trust {
    when windows {
        return GetCurrentProcessId() as i32
    }
    when posix {
        return getpid()
    }
    return 0
}

fn load_target(arena: allocators.Arena, program: ref u8) result[ref target.Target, ref u8] = trust {
    return target.load(arena, program)
}

type SymbolRow = {
    display: mut ref u8
    raw: mut ref u8
    address: mut ref u8
}

type VariableRow = {
    function: mut ref u8
    symbol: mut ref u8
    name: mut ref u8
    type_name: mut ref u8
    location: mut ref u8
}

fn table_max(width: i64, s: ref u8) i64 = trust {
    val n: i64 = util.len_raw[_](s)
    if n > width {
        return n
    }
    return width
}

fn table_field(s: ref u8, width: i64) void = trust {
    stdio.print("{s}", {s})
    val i: mut i64 = util.len_raw[_](s)
    for {
        if i >= width {
            break
        }
        stdio.print(" ", {})
        i++
    }
    stdio.print("  ", {})
}

fn table_last(s: ref u8) void = trust {
    stdio.print("{s}\n", {s})
}

fn symbol_row_add(
    rows: mut list[ref SymbolRow],
    display: ref u8,
    raw: ref u8,
    address: ref u8
) void = trust {
    val r: mut ref SymbolRow = @alloc(@sizeof(SymbolRow)) as ref SymbolRow
    r.display = display
    r.raw = raw
    r.address = address
    @append(rows, r)
}

fn symbol_rows(t: ref target.Target, query: ref u8) list[ref SymbolRow] = trust {
    val rows: mut list[ref SymbolRow] =
    @listalloc[allocators.HeapAllocator, ref SymbolRow](util.heap())?
    if util.len_raw[_](query) > 0 {
        val fns: list[ref dwarf.DwarfFunction] = target.find_functions(t, query, 200)
        for f in fns {
            symbol_row_add(rows, f.display, f.name, @fmtalloc("[{x}..{x}]", {
                f.low_pc, f.high_pc
            }))
        }
        for sym in t.elf_file.symbols {
            if elf.symbol_is_code(sym) && demangle.matches(sym.name, query) {
                symbol_row_add(rows, demangle.pretty(sym.name), sym.name, @fmtalloc("[{x}]", {
                    sym.value
                }))
            }
        }
        return rows
    }
    for f in t.dwarf_info.functions {
        symbol_row_add(rows, f.display, f.name, @fmtalloc("[{x}..{x}]", {
            f.low_pc, f.high_pc
        }))
    }
    return rows
}

fn print_symbol_table(rows: list[ref SymbolRow]) void = trust {
    if (@len(rows) as i64) == 0 {
        return
    }
    val name_w: mut i64 = 4
    val raw_w: mut i64 = 6
    val addr_w: mut i64 = 7
    for r in rows {
        name_w = table_max(name_w, r.display)
        raw_w = table_max(raw_w, r.raw)
        addr_w = table_max(addr_w, r.address)
    }
    table_field(c"NAME", name_w)
    table_field(c"SYMBOL", raw_w)
    table_last(c"ADDRESS")
    for r in rows {
        table_field(r.display, name_w)
        table_field(r.raw, raw_w)
        table_last(r.address)
    }
}

fn cmd_symbols(program: ref u8, query: ref u8) i32 = trust {
    val arena: allocators.Arena = allocators.Arena.new(64 * 1024 * 1024 as usize)?
    val t_opt = load_target(arena, program)
    val t: mut ref target.Target = none
    match t_opt {
        err e => {
            stdio.print("phantom: {s}\n", {e})
            return 1
        }
        ok tv => {
            t = tv
        }
    }
    val rows: list[ref SymbolRow] = symbol_rows(t, query)
    print_symbol_table(rows)
    return 0
}

fn cmd_lines(program: ref u8, query: ref u8) i32 = trust {
    val arena: allocators.Arena = allocators.Arena.new(64 * 1024 * 1024 as usize)?
    val t_opt = load_target(arena, program)
    val t: mut ref target.Target = none
    match t_opt {
        err e => {
            stdio.print("phantom: {s}\n", {e})
            return 1
        }
        ok tv => {
            t = tv
        }
    }
    if util.len_raw[_](query) == 0 {
        for row in t.dwarf_info.lines {
            if row.is_stmt && util.len_or_zero(row.file) > 0 {
                stdio.print("{s}:{lld} -> 0x{x}\n", {row.file, row.line, row.address})
            }
        }
        return 0
    }
    val colon: i64 = last_colon(query)
    if colon > 0 {
        val file: ref u8 = util.copy_cstr_len(query, colon)
        val line_opt = util.parse_i64[ref u8](@ptradd(query, colon + 1))
        if line_opt is some line {
            val addr_opt = target.line_address(t, file, line)
            if addr_opt is some addr {
                stdio.print("{s}:{lld} -> 0x{x}\n", {file, line, addr})
            } else {
                stdio.print("phantom: no address for {s}:{lld}\n", {file, line})
            }
        }
    } else {
        val sym_opt = target.function_address(t, query)
        if sym_opt is some addr {
            stdio.print("{s} -> 0x{x}\n", {query, addr})
        } else {
            stdio.print("phantom: no symbol matching '{s}'\n", {query})
        }
    }
    return 0
}

fn variable_row_add(
    rows: mut list[ref VariableRow],
    function: ref u8,
    symbol: ref u8,
    name: ref u8,
    type_name: ref u8,
    location: ref u8
) void = trust {
    val r: mut ref VariableRow = @alloc(@sizeof(VariableRow)) as ref VariableRow
    r.function = function
    r.symbol = symbol
    r.name = name
    r.type_name = type_name
    r.location = location
    @append(rows, r)
}

fn variable_rows(t: ref target.Target, fn_query: ref u8) list[ref VariableRow] = trust {
    val rows: mut list[ref VariableRow] =
    @listalloc[allocators.HeapAllocator, ref VariableRow](util.heap())?
    for f in t.dwarf_info.functions {
        if util.len_raw[_](fn_query) > 0 && !demangle.matches(f.name, fn_query) {
            continue
        }
        for v in f.variables {
            variable_row_add(
                rows,
                f.display,
                f.name,
                v.source_name,
                type_name_of(t.dwarf_info, v.type_off),
                @fmtalloc("{s}:{lld}", {v.file, v.line})
            )
        }
    }
    return rows
}

fn print_variable_table(rows: list[ref VariableRow]) void = trust {
    if (@len(rows) as i64) == 0 {
        return
    }
    val fn_w: mut i64 = 8
    val sym_w: mut i64 = 6
    val name_w: mut i64 = 8
    val type_w: mut i64 = 4
    val loc_w: mut i64 = 8
    for r in rows {
        fn_w = table_max(fn_w, r.function)
        sym_w = table_max(sym_w, r.symbol)
        name_w = table_max(name_w, r.name)
        type_w = table_max(type_w, r.type_name)
        loc_w = table_max(loc_w, r.location)
    }
    table_field(c"FUNCTION", fn_w)
    table_field(c"SYMBOL", sym_w)
    table_field(c"VARIABLE", name_w)
    table_field(c"TYPE", type_w)
    table_last(c"LOCATION")
    for r in rows {
        table_field(r.function, fn_w)
        table_field(r.symbol, sym_w)
        table_field(r.name, name_w)
        table_field(r.type_name, type_w)
        table_last(r.location)
    }
}

fn cmd_variables(program: ref u8, fn_query: ref u8) i32 = trust {
    val arena: allocators.Arena = allocators.Arena.new(64 * 1024 * 1024 as usize)?
    val t_opt = load_target(arena, program)
    val t: mut ref target.Target = none
    match t_opt {
        err e => {
            stdio.print("phantom: {s}\n", {e})
            return 1
        }
        ok tv => {
            t = tv
        }
    }
    val rows: list[ref VariableRow] = variable_rows(t, fn_query)
    print_variable_table(rows)
    return 0
}

fn type_name_of(info: ref dwarf.DwarfInfo, off: u64) ref u8 = trust {
    for t in info.types {
        if t.offset == off {
            if t.name != none && util.len_or_zero(t.name) > 0 {
                return demangle.source_name(t.name)
            }
            if t.tag == 15 {
                return @fmtalloc("{s} *", {type_name_of(info, t.type_off)})
            }
            if t.tag == 1 {
                return @fmtalloc("{s}[{lld}]", {type_name_of(info, t.type_off), t.count})
            }
        }
    }
    return c"?"
}

fn last_colon(s: ref u8) i64 = trust {
    val n: i64 = util.len_raw[_](s)
    val i: mut i64 = n - 1
    for {
        if i < 0 {
            break
        }
        if @load8(@ptradd(s, i)) == 58 {
            return i
        }
        i--
    }
    return -1
}

fn usage() void = trust {
    stdio.puts("phantom - spectre debugger")
    stdio.puts("")
    stdio.puts("usage:")
    stdio.puts("  phantom [options] <file.sx|binary> [-- program args...]")
    stdio.puts("  phantom debug <file.sx|binary> [options] [-- program args...]")
    stdio.puts("")
    stdio.puts("subcommands:")
    stdio.puts("  dap       [options]")
    stdio.puts("  build     <file.sx> [-o <output>]")
    stdio.puts("  symbols   <binary> [query]")
    stdio.puts("  lines     <binary> [file:line]")
    stdio.puts("  variables <binary> [function]")
    stdio.puts("")
    stdio.puts("options:")
    stdio.puts("  -backend lldb|native     select backend (default: lldb)")
    stdio.puts("  -compiler <path>         spectre compiler used for .sx inputs")
    stdio.puts("  -batch                   run commands non-interactively, then exit")
    stdio.puts("  -ex, -eval-command <cmd> execute one command (repeatable)")
    stdio.puts("  -x, -command <file>      execute commands from a file (repeatable)")
    stdio.puts("  -o <path>                output path for 'build'")
    stdio.puts("  -program <path>          preset program for 'dap'")
}

/// Turn a source file into a debuggable binary when needed.
fn prepare_program(
    input: ref u8,
    compiler: ref u8
) result[ref u8, ref u8] = trust {
    if util.ends_with[_, _](input, ".sx") {
        return build_source(compiler, input)
    }
    if !file_exists(input) {
        return err @fmtalloc("'{s}' does not exist", {input})
    }
    return ok input
}

fn batch_trim(s: ref u8) ref u8 = trust {
    if s == none {
        return c""
    }
    val n: i64 = util.len_raw[_](s)
    val start: mut i64 = 0
    for {
        if start >= n {
            break
        }
        val c: u8 = @load8(@ptradd(s, start))
        if c == 32 || c == 9 || c == 13 {
            start++
        } else {
            break
        }
    }
    val end: mut i64 = n
    for {
        if end <= start {
            break
        }
        val c: u8 = @load8(@ptradd(s, end - 1))
        if c == 32 || c == 9 || c == 13 {
            end--
        } else {
            break
        }
    }
    return util.copy_cstr_len(@ptradd(s, start), end - start)
}

fn batch_add_text(commands: mut list[ref u8], text: ref u8) void = trust {
    if text == none {
        return
    }
    val n: i64 = util.len_raw[_](text)
    val pos: mut i64 = 0
    for {
        if pos >= n {
            break
        }
        val end: mut i64 = pos
        for {
            if end >= n || @load8(@ptradd(text, end)) == 10 {
                break
            }
            end++
        }
        val line: ref u8 = batch_trim(util.copy_cstr_len(@ptradd(text, pos), end - pos))
        if util.len_raw[_](line) > 0 && @load8(line) != 35 {
            @append(commands, line)
        }
        pos = end + 1
    }
}

fn batch_add_file(commands: mut list[ref u8], path: ref u8) bool = trust {
    val data_opt = fs.read_all_heap_cstr(path)
    if data_opt is some dv {
        batch_add_text(commands, dv as ref u8)
        return true
    }
    return false
}

pub fn main() i32 = trust {
    val args: list[ref u8] = os.get_args()
    val argc: i64 = @len(args) as i64
    if argc < 2 {
        usage()
        return 1
    }
    val first: ref u8 = arg_at(args, 1)
    if util.eq[_, _](first, "help") || util.eq[_, _](first, "-h") ||
    util.eq[_, _](first, "--help") {
        usage()
        return 0
    }
    if util.eq[_, _](first, "version") || util.eq[_, _](first, "-v") ||
    util.eq[_, _](first, "--version") {
        stdio.print("phantom {s}\n", {VERSION})
        return 0
    }

    if util.eq[_, _](first, "symbols") {
        if argc < 3 {
            stdio.puts("usage: phantom symbols <binary> [query]")
            return 1
        }
        return cmd_symbols(arg_at(args, 2), arg_at(args, 3))
    }
    if util.eq[_, _](first, "lines") {
        if argc < 3 {
            stdio.puts("usage: phantom lines <binary> [file:line]")
            return 1
        }
        return cmd_lines(arg_at(args, 2), arg_at(args, 3))
    }
    if util.eq[_, _](first, "variables") {
        if argc < 3 {
            stdio.puts("usage: phantom variables <binary> [function]")
            return 1
        }
        return cmd_variables(arg_at(args, 2), arg_at(args, 3))
    }

    if util.eq[_, _](first, "build") {
        val source: ref u8 = arg_at(args, 2)
        if util.len_raw[_](source) == 0 {
            stdio.puts("usage: phantom build <file.sx> [-o <output>]")
            return 1
        }
        val compiler: mut ref u8 = c""
        val output: mut ref u8 = c""
        val i: mut i64 = 3
        for {
            if i >= argc {
                break
            }
            val a: ref u8 = arg_at(args, i)
            if util.eq[_, _](a, "--compiler") {
                i++
                compiler = arg_at(args, i)
            } elif util.eq[_, _](a, "-o") || util.eq[_, _](a, "--output") {
                i++
                output = arg_at(args, i)
            }
            i++
        }
        val comp: ref u8 = find_compiler(compiler)
        if util.len_raw[_](output) > 0 {
            val cmd: ref u8 = @fmtalloc(
                "{s} {s} -alt -no-single-flags -o {s} 2>&1",
                {comp, source, output}
            )
            val res = os.exec(cmd)
            match res {
                err e => {
                    stdio.print("phantom: {s}\n", {e})
                    return 1
                }
                ok text => {
                    val out_text: ref u8 = text.ptr
                    if util.len_raw[_](out_text) > 0 {
                        stdio.print("{s}\n", {out_text})
                    }
                    if file_exists(output) {
                        stdio.print("Compiled: {s}\n", {output})
                        return 0
                    }
                    return 1
                }
            }
        }
        val built = build_source(comp, source)
        match built {
            err e => {
                stdio.print("phantom: {s}\n", {e})
                return 1
            }
            ok out => {
                stdio.print("Compiled: {s}\n", {out})
                return 0
            }
        }
    }

    val is_dap: bool = util.eq[_, _](first, "dap")
    val is_debug: bool = util.eq[_, _](first, "debug")
    val input: mut ref u8 = c""
    val backend: mut ref u8 = c"lldb"
    val compiler: mut ref u8 = c""
    val program_override: mut ref u8 = c""
    val prog_args: mut list[ref u8] = @listalloc[allocators.HeapAllocator, ref u8](util.heap())?
    val batch: mut bool = false
    val batch_commands: mut list[ref u8] = @listalloc[allocators.HeapAllocator, ref u8](util.heap())?
    val i: mut i64 = 1
    if is_dap || is_debug {
        i = 2
    }
    val saw_separator: mut bool = false
    for {
        if i >= argc {
            break
        }
        val a: ref u8 = arg_at(args, i)
        if saw_separator {
            @append(prog_args, a)
        } elif util.eq[_, _](a, "--") {
            saw_separator = true
        } elif util.eq[_, _](a, "-backend") || util.eq[_, _](a, "-b") {
            i++
            backend = arg_at(args, i)
        } elif util.eq[_, _](a, "-compiler") {
            i++
            compiler = arg_at(args, i)
        } elif util.eq[_, _](a, "-program") {
            i++
            program_override = arg_at(args, i)
        } elif util.eq[_, _](a, "-batch") || util.eq[_, _](a, "--batch") {
            batch = true
        } elif util.eq[_, _](a, "-ex") || util.eq[_, _](a, "--eval-command") {
            i++
            val command: ref u8 = batch_trim(arg_at(args, i))
            if util.len_raw[_](command) > 0 {
                @append(batch_commands, command)
            }
        } elif util.starts_with[_, _](a, "--eval-command=") {
            val command: ref u8 = batch_trim(
                @ptradd(a, util.len_raw[_]("--eval-command="))
            )
            if util.len_raw[_](command) > 0 {
                @append(batch_commands, command)
            }
        } elif util.eq[_, _](a, "-x") || util.eq[_, _](a, "-command") {
            i++
            val path: ref u8 = arg_at(args, i)
            if !batch_add_file(batch_commands, path) {
                stdio.print("phantom: cannot read command file '{s}'\n", {path})
                return 1
            }
        } elif util.starts_with[_, _](a, "-command=") {
            val path: ref u8 = @ptradd(a, util.len_raw[_]("-command="))
            if !batch_add_file(batch_commands, path) {
                stdio.print("phantom: cannot read command file '{s}'\n", {path})
                return 1
            }
        } else {
            if !is_dap {
                if util.len_raw[_](input) == 0 {
                    input = a
                } else {
                    @append(prog_args, a)
                }
            }
        }
        i++
    }
    val comp: ref u8 = find_compiler(compiler)
    if is_dap {
        return dap.run(comp, backend, program_override, prog_args)
    }
    if util.len_raw[_](input) == 0 {
        stdio.puts("usage: phantom [options] <file.sx|binary> [-- args...]")
        stdio.puts("       phantom debug <file.sx|binary> [options] [-- args...]")
        return 1
    }
    val prog = prepare_program(input, comp)
    val program: mut ref u8 = c""
    match prog {
        err e => {
            stdio.print("phantom: {s}\n", {e})
            return 1
        }
        ok pv => {
            program = pv
        }
    }
    val arena: allocators.Arena = allocators.Arena.new(64 * 1024 * 1024 as usize)?
    val t_opt = load_target(arena, program)
    val t: mut ref target.Target = none
    match t_opt {
        err e => {
            if util.eq[_, _](backend, "native") || util.eq[_, _](backend, "dwarf") ||
            util.eq[_, _](backend, "ptrace") {
                stdio.print("phantom: {s}\n", {e})
                return 1
            }
            t = target.empty(arena, program)
        }
        ok tv => {
            t = tv
        }
    }
    return cli.run(t, program, backend, prog_args, batch, batch_commands)
}

test "batch commands trim whitespace and skip comments" {
    trust {
        val commands: mut list[ref u8] = @listalloc[allocators.HeapAllocator, ref u8](util.heap())?
        batch_add_text(commands, c"# comment\n\n  break main \t\nrun\n")
        assert (@len(commands) as i64) == 2
        val first = @get(commands, 0)
        match first {
            some v => {
                assert util.eq[_, _](v as ref u8, "break main")
            }
            none => {
                assert false
            }
        }
        val second = @get(commands, 1)
        match second {
            some v => {
                assert util.eq[_, _](v as ref u8, "run")
            }
            none => {
                assert false
            }
        }
    }
}

test "batch trim handles empty and padded input" {
    trust {
        assert util.eq[ref u8, ref u8](batch_trim(c"   "), c"")
        assert util.eq[ref u8, ref u8](batch_trim(c"  next  "), c"next")
    }
}
