/// LLDB command wrapper used by Phantom's default backend.
///
/// (C) Navid Momtahen - 2026
/// SPDX-License-Identifier: GPL-3.0-only

val string     = use("std/string")
val allocators = use("std/allocators")
val proc       = use("proc.sx")
val util       = use("util.sx")
val demangle   = use("demangle.sx")

when posix {
    extern (C, header) fn usleep(usec: u32) i32 = "usleep"
}

pub type LldbFrame = {
    index: mut i64
    address: mut u64
    function_raw: mut ref u8
    function_display: mut ref u8
    file: mut ref u8
    line: mut i64
    column: mut i64
}

pub type LldbVar = {
    type_name: mut ref u8
    raw_name: mut ref u8
    name: mut ref u8
    value: mut ref u8
}

pub type LldbSession = {
    child: mut ref proc.Child
    program: mut ref u8
    alive: mut bool
    stopped: mut bool
    exited: mut bool
    exit_code: mut i64
    last_output: mut ref u8
}

val MARKER: ref u8 = "@@PHANTOM_LLDB_END_a91c@@"

fn argv_new() list[ref u8] = trust {
    return @listalloc[allocators.HeapAllocator, ref u8](util.heap())?
}

fn hex_encode(s: ref u8) ref u8 = trust {
    val n: i64 = string.len_raw(s)
    val out: ref u8 = @alloc((n * 2 + 1) as usize) as ref u8
    if out == none {
        return ""
    }
    val digits: ref u8 = "0123456789abcdef"
    val i: mut i64 = 0
    for {
        if i >= n {
            break
        }
        val c: u8 = @load8(@ptradd(s, i))
        @store8(@ptradd(out, i * 2), @load8(@ptradd(digits, (c >> 4) as i64)))
        @store8(@ptradd(out, i * 2 + 1), @load8(@ptradd(digits, (c & 15) as i64)))
        i++
    }
    @store8(@ptradd(out, n * 2), 0)
    return out
}

/// Start an LLDB process and select `program` as its target.
pub fn new(lldb_path: ref u8, program: ref u8) result[ref LldbSession, ref u8] = trust {
    val lldb_cmd: mut ref u8 = lldb_path
    if lldb_cmd == none || string.len_raw(lldb_cmd) == 0 {
        lldb_cmd = "lldb"
    }
    val argv: mut list[ref u8] = argv_new()
    @append(argv, lldb_cmd)
    @append(argv, "--no-lldbinit")
    val nullp: ref u8 = none
    @append(argv, nullp)
    val child_opt = proc.spawn(argv)
    val child: mut ref proc.Child = none
    match child_opt {
        err e => {
            return err @fmtalloc("could not start lldb: {s}", {e})
        }
        ok c => {
            child = c
        }
    }
    val s: mut ref LldbSession = @alloc(@sizeof(LldbSession)) as ref LldbSession
    @memset(s, 0, @sizeof(LldbSession) as usize)
    s.child = child
    s.program = program
    s.alive = true
    s.stopped = false
    s.exited = false
    s.exit_code = 0
    s.last_output = ""
    // Give lldb's line editor a moment to attach to the pipe before we start
    // feeding commands. This avoids a startup race on non-tty stdin.
    when posix {
        usleep(50000 as u32)
    }
    // Flush the startup banner.
    command(s, "settings set interpreter.prompt-on-quit false")
    command(s, "settings set target.x86-disassembly-flavor intel")
    val tar: ref u8 = @fmtalloc("target create -- \"{s}\"", {program})
    val out: ref u8 = command(s, tar)
    if util.contains(out, "error:") {
        return err @fmtalloc("lldb could not load '{s}'", {program})
    }
    return ok s
}

/// Send one command to lldb and return all output produced before it stopped.
///
/// Commands are executed through lldb's Python API so that the completion
/// marker can be printed *after* the command has finished. In particular,
/// `process launch` and `process continue` return immediately in asynchronous
/// mode; commands written while the inferior is running are not executed, so a
/// plain marker command on the next input line would be lost and we would
/// block forever waiting for it. The wrapper also waits for the process to
/// stop or exit before printing the marker.
pub fn command(s: mut ref LldbSession, cmd: ref u8) ref u8 = trust {
    if s == none || !s.alive {
        return ""
    }
    if string.str_eql(cmd, "quit") {
        proc.write_all(s.child.in_fd, "quit\n", 5)
        s.alive = false
        return ""
    }
    val cmd_hex: ref u8 = hex_encode(cmd)
    val marker_hex: ref u8 = hex_encode(MARKER)
    val wrapped: ref u8 = @fmtalloc(
        "script import lldb,time; d=lldb.debugger; t=d.GetSelectedTarget(); d.HandleCommand(bytes.fromhex('{s}').decode('utf-8','surrogateescape')); p=t.GetProcess(); exec(\"while p.IsValid() and p.GetState() in (lldb.eStateLaunching,lldb.eStateAttaching,lldb.eStateConnected,lldb.eStateRunning,lldb.eStateStepping):\\n    time.sleep(0.01)\"); print(bytes.fromhex('{s}').decode('utf-8'))",
        {cmd_hex, marker_hex}
    )
    if !proc.write_all(s.child.in_fd, wrapped, string.len_raw(wrapped)) {
        s.alive = false
        return ""
    }
    if !proc.write_all(s.child.in_fd, "\n", 1) {
        s.alive = false
        return ""
    }
    val out: ref u8 = proc.read_until(s.child.out_fd, MARKER, 8 * 1024 * 1024)
    s.last_output = out
    update_state(s, out)
    return out
}

fn update_state(s: mut ref LldbSession, out: ref u8) void = trust {
    if util.contains(out, "Cannot launch") || util.contains(out, "ptrace failed") {
        s.stopped = false
        s.exited = true
        s.exit_code = 1
        return
    }
    if util.contains(out, "exited with status") || util.contains(out, "exited normally") {
        s.stopped = false
        s.exited = true
        s.exit_code = parse_exit_code(out)
        return
    }
    if util.contains(out, "stop reason =") || util.contains(out, "Process ") && util.contains(out, "stopped") {
        s.stopped = true
        s.exited = false
        return
    }
    if util.contains(out, "error:") {
        return
    }
}

fn parse_exit_code(out: ref u8) i64 = trust {
    val marker: ref u8 = "exited with status = "
    val n: i64 = string.len_raw(out)
    val m: i64 = string.len_raw(marker)
    val i: mut i64 = 0
    for {
        if i > n - m {
            break
        }
        val matched: mut bool = true
        val j: mut i64 = 0
        for {
            if j >= m {
                break
            }
            if @load8(@ptradd(out, i + j)) != @load8(@ptradd(marker, j)) {
                matched = false
                break
            }
            j++
        }
        if matched {
            val val_opt = util.parse_i64(util.copy_cstr_len(@ptradd(out, i + m), 32))
            if val_opt is some v {
                return v
            }
            break
        }
        i++
    }
    return 0
}

/// Strip lldb's command echo and Phantom's internal marker commands.
pub fn clean_output(out: ref u8) ref u8 = trust {
    if out == none {
        return ""
    }
    val sb: ref void = string.StringBuilder.new()
    val n: i64 = string.len_raw(out)
    val pos: mut i64 = 0
    for {
        if pos >= n {
            break
        }
        val end: mut i64 = pos
        for {
            if end >= n || @load8(@ptradd(out, end)) == 10 {
                break
            }
            end++
        }
        val line: ref u8 = util.copy_cstr_len(@ptradd(out, pos), end - pos)
        val skip: bool = string.str_eql(line, MARKER) ||
        string.raw_starts_with(line, "script import lldb,time") ||
        string.raw_starts_with(line, "(lldb) script import lldb,time")
        if !skip {
            if string.raw_starts_with(line, "(lldb) ") {
                string.StringBuilder.append_cstr(sb, @ptradd(line, 7))
            } else {
                string.StringBuilder.append_cstr(sb, line)
            }
            string.StringBuilder.append_char(sb, 10)
        }
        pos = end + 1
    }
    val built: string.String = string.StringBuilder.build(sb)
    val res: ref u8 = util.copy_cstr(string.cstr(built))
    string.StringBuilder.free(sb)
    return res
}

/// Launch the target with optional arguments.
pub fn run(s: mut ref LldbSession, args: list[ref u8]) ref u8 = trust {
    val sb: ref void = string.StringBuilder.new()
    string.StringBuilder.append_cstr(sb, "process launch")
    for a in args {
        string.StringBuilder.append_cstr(sb, " \"")
        string.StringBuilder.append_cstr(sb, a)
        string.StringBuilder.append_cstr(sb, "\"")
    }
    val built: string.String = string.StringBuilder.build(sb)
    val cmd: ref u8 = util.copy_cstr(string.cstr(built))
    string.StringBuilder.free(sb)
    return command(s, cmd)
}

pub fn cont(s: mut ref LldbSession) ref u8 = trust {
    return command(s, "process continue")
}

pub fn next(s: mut ref LldbSession) ref u8 = trust {
    return command(s, "thread step-over")
}

pub fn step(s: mut ref LldbSession) ref u8 = trust {
    return command(s, "thread step-in")
}

pub fn finish(s: mut ref LldbSession) ref u8 = trust {
    return command(s, "thread step-out")
}

pub fn breakpoint_symbol(s: mut ref LldbSession, name: ref u8) ref u8 = trust {
    return command(s, @fmtalloc("breakpoint set --name {s}", {name}))
}

pub fn breakpoint_file_line(s: mut ref LldbSession, file: ref u8, line: i64) ref u8 = trust {
    return command(s, @fmtalloc("breakpoint set --file {s} --line {lld}", {util.basename(file), line}))
}

pub fn breakpoint_address(s: mut ref LldbSession, address: u64) ref u8 = trust {
    return command(s, @fmtalloc("breakpoint set --address 0x{x}", {address}))
}

pub fn delete_breakpoint(s: mut ref LldbSession, id: i64) ref u8 = trust {
    return command(s, @fmtalloc("breakpoint delete {lld}", {id}))
}

pub fn list_breakpoints(s: mut ref LldbSession) ref u8 = trust {
    return command(s, "breakpoint list")
}

pub fn backtrace(s: mut ref LldbSession, count: i64) ref u8 = trust {
    return command(s, @fmtalloc("thread backtrace -c {lld}", {count}))
}

pub fn frame_variables(s: mut ref LldbSession) ref u8 = trust {
    return command(s, "frame variable --show-types")
}

pub fn expression(s: mut ref LldbSession, expr: ref u8) ref u8 = trust {
    return command(s, @fmtalloc("expression -- {s}", {expr}))
}

pub fn threads(s: mut ref LldbSession) ref u8 = trust {
    return command(s, "thread list")
}

pub fn source_line(s: mut ref LldbSession, line: i64) ref u8 = trust {
    return command(s, @fmtalloc("source list --line {lld}", {line}))
}

pub fn quit(s: mut ref LldbSession) void = trust {
    if s == none || !s.alive {
        return
    }
    command(s, "process kill")
    command(s, "quit")
    proc.terminate(s.child)
    s.alive = false
}

fn find_char(s: ref u8, start: i64, ch: u8) i64 = trust {
    val n: i64 = string.len_raw(s)
    val i: mut i64 = start
    for {
        if i >= n {
            return -1
        }
        if @load8(@ptradd(s, i)) == ch {
            return i
        }
        i++
    }
    return -1
}

/// Parse the `frame #N:` rows from a backtrace or stop message.
pub fn parse_frames(out: ref u8) list[ref LldbFrame] = trust {
    val frames: mut list[ref LldbFrame] = @listalloc[allocators.HeapAllocator, ref LldbFrame](util.heap())?
    val n: i64 = string.len_raw(out)
    val pos: mut i64 = 0
    for {
        if pos >= n {
            break
        }
        val end: mut i64 = pos
        for {
            if end >= n || @load8(@ptradd(out, end)) == 10 {
                break
            }
            end++
        }
        val line: ref u8 = util.copy_cstr_len(@ptradd(out, pos), end - pos)
        if util.contains(line, "frame #") {
            val f: ref LldbFrame = parse_frame_line(line)
            if f != none {
                @append(frames, f)
            }
        }
        pos = end + 1
    }
    return frames
}

fn parse_frame_line(line: ref u8) ref LldbFrame = trust {
    val fpos: i64 = index_of(line, "frame #")
    if fpos < 0 {
        return none
    }
    val f: mut ref LldbFrame = @alloc(@sizeof(LldbFrame)) as ref LldbFrame
    @memset(f, 0, @sizeof(LldbFrame) as usize)
    val p: mut i64 = fpos + 7
    val idx: mut i64 = 0
    val n: i64 = string.len_raw(line)
    for {
        if p >= n {
            break
        }
        val c: u8 = @load8(@ptradd(line, p))
        if c < 48 || c > 57 {
            break
        }
        idx = idx * 10 + ((c - 48) as i64)
        p++
    }
    f.index = idx
    val bt: i64 = find_char(line, p, 96)
    if bt < 0 {
        return f
    }
    // Address is the last token before the backtick.
    val apos: mut i64 = bt - 1
    for {
        if apos < 0 {
            break
        }
        val c: u8 = @load8(@ptradd(line, apos))
        if c == 32 {
            break
        }
        apos--
    }
    val addr_txt: ref u8 = util.copy_cstr_len(@ptradd(line, apos + 1), bt - apos - 1)
    val addr_opt = util.parse_u64_hex(addr_txt)
    if addr_opt is some av {
        f.address = av
    }
    // Symbol ends at '(' or whitespace.
    val send: mut i64 = bt + 1
    for {
        if send >= n {
            break
        }
        val c: u8 = @load8(@ptradd(line, send))
        if c == 40 || c == 32 || c == 43 {
            break
        }
        send++
    }
    f.function_raw = util.copy_cstr_len(@ptradd(line, bt + 1), send - bt - 1)
    f.function_display = demangle.pretty(f.function_raw)
    if string.len_raw(f.function_display) == 0 {
        f.function_display = f.function_raw
    }
    val atpos: i64 = index_sub(line, " at ", send)
    if atpos >= 0 {
        val sstart: i64 = atpos + 4
        val colon: mut i64 = -1
        val i: mut i64 = sstart
        for {
            if i >= n {
                break
            }
            val c: u8 = @load8(@ptradd(line, i))
            if c == 58 {
                colon = i
                // Prefer the last colon: path may not contain one, but a
                // Windows drive letter can.
            }
            i++
        }
        if colon > sstart {
            f.file = util.copy_cstr_len(@ptradd(line, sstart), colon - sstart)
            val lstart: i64 = colon + 1
            val line_no: mut i64 = 0
            val j: mut i64 = lstart
            for {
                if j >= n {
                    break
                }
                val c: u8 = @load8(@ptradd(line, j))
                if c < 48 || c > 57 {
                    break
                }
                line_no = line_no * 10 + ((c - 48) as i64)
                j++
            }
            f.line = line_no
            if j < n && @load8(@ptradd(line, j)) == 58 {
                val col: mut i64 = 0
                val k: mut i64 = j + 1
                for {
                    if k >= n {
                        break
                    }
                    val c: u8 = @load8(@ptradd(line, k))
                    if c < 48 || c > 57 {
                        break
                    }
                    col = col * 10 + ((c - 48) as i64)
                    k++
                }
                f.column = col
            }
        }
    }
    return f
}

fn index_of(s: ref u8, needle: ref u8) i64 = trust {
    return index_sub(s, needle, 0)
}

fn index_sub(s: ref u8, needle: ref u8, start: i64) i64 = trust {
    val n: i64 = string.len_raw(s)
    val m: i64 = string.len_raw(needle)
    if m <= 0 || n < m {
        return -1
    }
    val i: mut i64 = start
    for {
        if i > n - m {
            break
        }
        val matched: mut bool = true
        val j: mut i64 = 0
        for {
            if j >= m {
                break
            }
            if @load8(@ptradd(s, i + j)) != @load8(@ptradd(needle, j)) {
                matched = false
                break
            }
            j++
        }
        if matched {
            return i
        }
        i++
    }
    return -1
}

/// Parse `frame variable` output into source-friendly variable records.
pub fn parse_variables(out: ref u8) list[ref LldbVar] = trust {
    val vars: mut list[ref LldbVar] = @listalloc[allocators.HeapAllocator, ref LldbVar](util.heap())?
    val n: i64 = string.len_raw(out)
    val pos: mut i64 = 0
    for {
        if pos >= n {
            break
        }
        val end: mut i64 = pos
        for {
            if end >= n || @load8(@ptradd(out, end)) == 10 {
                break
            }
            end++
        }
        val line: ref u8 = util.copy_cstr_len(@ptradd(out, pos), end - pos)
        if string.len_raw(line) > 0 && @load8(line) == 40 {
            val rp: i64 = find_char(line, 0, 41)
            if rp > 0 {
                val v: mut ref LldbVar = @alloc(@sizeof(LldbVar)) as ref LldbVar
                @memset(v, 0, @sizeof(LldbVar) as usize)
                v.type_name = util.copy_cstr_len(@ptradd(line, 1), rp - 1)
                val name_start: mut i64 = rp + 1
                for {
                    if name_start >= end - pos {
                        break
                    }
                    val c: u8 = @load8(@ptradd(line, name_start))
                    if c != 32 && c != 9 {
                        break
                    }
                    name_start++
                }
                val eq: i64 = find_char(line, name_start, 61)
                val name_end: mut i64 = eq
                if name_end < 0 {
                    name_end = string.len_raw(line)
                }
                val trim_end: mut i64 = name_end
                for {
                    if trim_end <= name_start {
                        break
                    }
                    val c: u8 = @load8(@ptradd(line, trim_end - 1))
                    if c != 32 && c != 9 {
                        break
                    }
                    trim_end--
                }
                v.raw_name = util.copy_cstr_len(@ptradd(line, name_start), trim_end - name_start)
                v.name = demangle.source_name(v.raw_name)
                if eq >= 0 {
                    val vs: mut i64 = eq + 1
                    for {
                        if vs >= string.len_raw(line) {
                            break
                        }
                        val c: u8 = @load8(@ptradd(line, vs))
                        if c != 32 && c != 9 {
                            break
                        }
                        vs++
                    }
                    v.value = util.copy_cstr_len(@ptradd(line, vs), string.len_raw(line) - vs)
                }
                @append(vars, v)
            }
        }
        pos = end + 1
    }
    return vars
}

/// Rewrite source-level identifiers in an expression to the compiler's
/// internal (`t_`, `sx__`) names as reported by the current frame.
pub fn rewrite_expression(s: mut ref LldbSession, expr: ref u8) ref u8 = trust {
    if expr == none {
        return ""
    }
    val vars: list[ref LldbVar] = parse_variables(clean_output(frame_variables(s)))
    if @len(vars) == 0 {
        return expr
    }
    val out: ref u8 = @alloc((string.len_raw(expr) * 2 + 32) as usize) as ref u8
    @memset(out, 0, (string.len_raw(expr) * 2 + 32) as usize)
    val n: i64 = string.len_raw(expr)
    val i: mut i64 = 0
    val oi: mut i64 = 0
    for {
        if i >= n {
            break
        }
        val c: u8 = @load8(@ptradd(expr, i))
        val ident_start: bool = (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95
        if ident_start {
            val start: i64 = i
            val j: mut i64 = i + 1
            for {
                if j >= n {
                    break
                }
                val d: u8 = @load8(@ptradd(expr, j))
                val ident_char: bool = (d >= 65 && d <= 90) || (d >= 97 && d <= 122) ||
                (d >= 48 && d <= 57) || d == 95
                if !ident_char {
                    break
                }
                j++
            }
            val word: ref u8 = util.copy_cstr_len(@ptradd(expr, start), j - start)
            val replacement: mut ref u8 = word
            for v in vars {
                if string.str_eql(v.name, word) {
                    replacement = v.raw_name
                    break
                }
            }
            val rlen: i64 = string.len_raw(replacement)
            @memcpy(@ptradd(out, oi), replacement, rlen as usize)
            oi += rlen
            i = j
        } else {
            @store8(@ptradd(out, oi), c)
            oi++
            i++
        }
    }
    @store8(@ptradd(out, oi), 0)
    return out
}

fn trim_copy(s: ref u8) ref u8 = trust {
    if s == none {
        return ""
    }
    val n: i64 = string.len_raw(s)
    val start: mut i64 = 0
    for {
        if start >= n {
            break
        }
        val c: u8 = @load8(@ptradd(s, start))
        if c == 32 || c == 9 {
            start++
        } else {
            break
        }
    }
    val end: mut i64 = n
    for {
        if end <= start {
            break
        }
        val c: u8 = @load8(@ptradd(s, end - 1))
        if c == 32 || c == 9 {
            end--
        } else {
            break
        }
    }
    return util.copy_cstr_len(@ptradd(s, start), end - start)
}

fn map_c_base(s: ref u8) ref u8 = trust {
    if string.str_eql(s, "int") || string.str_eql(s, "signed int") {
        return "i32"
    }
    if string.str_eql(s, "unsigned int") || string.str_eql(s, "unsigned") {
        return "u32"
    }
    if string.str_eql(s, "short") || string.str_eql(s, "short int") {
        return "i16"
    }
    if string.str_eql(s, "unsigned short") || string.str_eql(s, "unsigned short int") {
        return "u16"
    }
    if string.str_eql(s, "long") || string.str_eql(s, "long int") ||
    string.str_eql(s, "long long") || string.str_eql(s, "long long int") {
        return "i64"
    }
    if string.str_eql(s, "unsigned long") || string.str_eql(s, "unsigned long int") ||
    string.str_eql(s, "unsigned long long") || string.str_eql(s, "unsigned long long int") {
        return "u64"
    }
    if string.str_eql(s, "int64_t") {
        return "i64"
    }
    if string.str_eql(s, "uint64_t") {
        return "u64"
    }
    if string.str_eql(s, "int32_t") {
        return "i32"
    }
    if string.str_eql(s, "uint32_t") {
        return "u32"
    }
    if string.str_eql(s, "int16_t") {
        return "i16"
    }
    if string.str_eql(s, "uint16_t") {
        return "u16"
    }
    if string.str_eql(s, "int8_t") || string.str_eql(s, "signed char") {
        return "i8"
    }
    if string.str_eql(s, "uint8_t") || string.str_eql(s, "unsigned char") ||
    string.str_eql(s, "char") {
        return "u8"
    }
    if string.str_eql(s, "size_t") || string.str_eql(s, "uintptr_t") {
        return "usize"
    }
    if string.str_eql(s, "ssize_t") || string.str_eql(s, "intptr_t") {
        return "isize"
    }
    if string.str_eql(s, "bool") || string.str_eql(s, "_Bool") {
        return "bool"
    }
    if string.str_eql(s, "float") {
        return "f32"
    }
    if string.str_eql(s, "double") {
        return "f64"
    }
    if string.str_eql(s, "void") {
        return "void"
    }
    return ""
}

/// Translate a C type name reported by LLDB into its Spectre spelling.
pub fn spectre_type(c_type: ref u8) ref u8 = trust {
    val t: ref u8 = trim_copy(c_type)
    if string.len_raw(t) == 0 {
        return ""
    }
    val depth: mut i64 = 0
    val end: mut i64 = string.len_raw(t)
    for {
        for {
            if end <= 0 {
                break
            }
            val c: u8 = @load8(@ptradd(t, end - 1))
            if c == 32 || c == 9 {
                end--
            } else {
                break
            }
        }
        if end <= 0 {
            break
        }
        if @load8(@ptradd(t, end - 1)) == 42 {
            depth++
            end--
        } else {
            break
        }
    }
    val base: ref u8 = trim_copy(util.copy_cstr_len(t, end))
    val mapped: ref u8 = map_c_base(base)
    if string.len_raw(mapped) == 0 {
        return ""
    }
    val out: mut ref u8 = mapped
    val i: mut i64 = 0
    for {
        if i >= depth {
            break
        }
        out = @fmtalloc("ref {s}", {out})
        i++
    }
    return out
}

/// Translate a Spectre type name into a C type usable in an LLDB expression.
pub fn spectre_to_c_type(t: ref u8) ref u8 = trust {
    val s: ref u8 = trim_copy(t)
    if string.raw_starts_with(s, "ref ") {
        val inner: ref u8 = trim_copy(@ptradd(s, 4))
        if string.str_eql(inner, "u8") {
            return "char *"
        }
        if string.str_eql(inner, "ref u8") {
            return "char * *"
        }
        val inner_c: ref u8 = spectre_to_c_type(inner)
        if string.len_raw(inner_c) == 0 {
            return ""
        }
        return @fmtalloc("{s} *", {inner_c})
    }
    if string.str_eql(s, "i8") {
        return "signed char"
    }
    if string.str_eql(s, "u8") {
        return "unsigned char"
    }
    if string.str_eql(s, "i16") {
        return "short"
    }
    if string.str_eql(s, "u16") {
        return "unsigned short"
    }
    if string.str_eql(s, "i32") {
        return "int"
    }
    if string.str_eql(s, "u32") {
        return "unsigned int"
    }
    if string.str_eql(s, "i64") {
        return "long"
    }
    if string.str_eql(s, "u64") {
        return "unsigned long"
    }
    if string.str_eql(s, "usize") {
        return "size_t"
    }
    if string.str_eql(s, "isize") {
        return "long"
    }
    if string.str_eql(s, "bool") {
        return "_Bool"
    }
    if string.str_eql(s, "f32") {
        return "float"
    }
    if string.str_eql(s, "f64") {
        return "double"
    }
    if string.str_eql(s, "void") {
        return "void"
    }
    return ""
}

fn expression_line_value(out: ref u8) ref u8 = trust {
    val n: i64 = string.len_raw(out)
    val end: mut i64 = n
    for {
        if end <= 0 {
            break
        }
        val c: u8 = @load8(@ptradd(out, end - 1))
        if c == 10 || c == 13 || c == 32 || c == 9 {
            end--
        } else {
            break
        }
    }
    val start: mut i64 = end
    for {
        if start <= 0 {
            break
        }
        val c: u8 = @load8(@ptradd(out, start - 1))
        if c == 10 || c == 13 {
            break
        }
        start--
    }
    val line: ref u8 = util.copy_cstr_len(@ptradd(out, start), end - start)
    val rp: i64 = find_char(line, 0, 41)
    val search: mut i64 = 0
    if rp >= 0 {
        search = rp + 1
    }
    val eq: i64 = find_char(line, search, 61)
    if eq < 0 {
        return line
    }
    val vs: mut i64 = eq + 1
    val ln: i64 = string.len_raw(line)
    for {
        if vs >= ln {
            break
        }
        val c: u8 = @load8(@ptradd(line, vs))
        if c == 32 || c == 9 {
            vs++
        } else {
            break
        }
    }
    val value: ref u8 = util.copy_cstr_len(@ptradd(line, vs), ln - vs)
    val q1: i64 = find_char(value, 0, 34)
    if q1 >= 0 {
        val vn: i64 = string.len_raw(value)
        val q2: mut i64 = vn - 1
        for {
            if q2 <= q1 {
                break
            }
            if @load8(@ptradd(value, q2)) == 34 {
                return util.copy_cstr_len(@ptradd(value, q1), q2 - q1 + 1)
            }
            q2--
        }
    }
    return value
}

/// Read up to 16 elements of an array-like variable through LLDB expressions.
pub fn read_array(
    s: mut ref LldbSession,
    raw_name: ref u8,
    elem_c_type: ref u8,
    count: i64
) ref u8 = trust {
    if s == none || !s.alive || count <= 0 ||
    string.len_raw(raw_name) == 0 || string.len_raw(elem_c_type) == 0 {
        return ""
    }
    val sb: ref void = string.StringBuilder.new()
    string.StringBuilder.append_cstr(sb, "[")
    val limit: mut i64 = count
    if limit > 16 {
        limit = 16
    }
    val i: mut i64 = 0
    for {
        if i >= limit {
            break
        }
        if i > 0 {
            string.StringBuilder.append_cstr(sb, ", ")
        }
        val expr: ref u8 = @fmtalloc("(({s}*)({s}))[{lld}]", {
            elem_c_type, raw_name, i
        })
        val out: ref u8 = clean_output(expression(s, expr))
        if util.contains(out, "error:") {
            string.StringBuilder.free(sb)
            return ""
        }
        val drawn: ref u8 = expression_line_value(out)
        if string.len_raw(drawn) == 0 {
            string.StringBuilder.free(sb)
            return ""
        }
        string.StringBuilder.append_cstr(sb, drawn)
        i++
    }
    if count > limit {
        string.StringBuilder.append_cstr(sb, ", ...")
    }
    string.StringBuilder.append_cstr(sb, "]")
    val built: string.String = string.StringBuilder.build(sb)
    val res: ref u8 = util.copy_cstr(string.cstr(built))
    string.StringBuilder.free(sb)
    return res
}

test "hex encoding roundtrips lldb command text" {
    trust {
        assert string.str_eql(hex_encode("abc"), "616263")
        assert string.str_eql(hex_encode(""), "")
        assert string.str_eql(hex_encode("a b'c"), "6120622763")
    }
}

test "maps C types to Spectre types" {
    trust {
        assert string.str_eql(spectre_type("int"), "i32")
        assert string.str_eql(spectre_type("int64_t"), "i64")
        assert string.str_eql(spectre_type("unsigned long"), "u64")
        assert string.str_eql(spectre_type("char *"), "ref u8")
        assert string.str_eql(spectre_type("char **"), "ref ref u8")
        assert string.str_eql(spectre_type("float"), "f32")
        assert string.str_eql(spectre_type("double"), "f64")
    }
}

test "maps Spectre types back to C types" {
    trust {
        assert string.str_eql(spectre_to_c_type("i64"), "long")
        assert string.str_eql(spectre_to_c_type("u8"), "unsigned char")
        assert string.str_eql(spectre_to_c_type("ref u8"), "char *")
        assert string.str_eql(spectre_to_c_type("ref ref u8"), "char * *")
        assert string.str_eql(spectre_to_c_type("ref i32"), "int *")
    }
}
