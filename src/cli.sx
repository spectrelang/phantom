val stdio      = use("std/stdio")
val string     = use("std/string")
val fs         = use("std/fs")
val allocators = use("std/allocators")
val util       = use("util.sx")
val target     = use("target.sx")
val dwarf      = use("dwarf.sx")
val lldb       = use("lldb.sx")
val native     = use("native.sx")

extern (C, header) fn fgets(s: ref u8, size: i32, stream: ref void) ref u8 = "fgets"

fn read_command() ref u8 = trust {
    val buf: mut [8192]u8 = @zeroed
    val p: ref u8 = fgets(@addr(buf) as ref u8, 8192, @stdin())
    if p == none {
        return ""
    }
    val out: ref u8 = @addr(buf) as ref u8
    val n: i64 = string.len_raw(out)
    if n > 0 && @load8(@ptradd(out, n - 1)) == 10 {
        @store8(@ptradd(out, n - 1), 0)
    }
    if n > 1 && @load8(@ptradd(out, n - 2)) == 13 {
        @store8(@ptradd(out, n - 2), 0)
    }
    return util.copy_cstr(out)
}

fn split_word(line: ref u8, out_rest: mut ref u8) ref u8 = trust {
    val n: i64 = string.len_raw(line)
    val i: mut i64 = 0
    for {
        if i >= n {
            break
        }
        val c: u8 = @load8(@ptradd(line, i))
        if c == 32 || c == 9 {
            break
        }
        i++
    }
    @store(out_rest, @ptradd(line, i))
    val rest: ref u8 = @load(out_rest)
    val rn: i64 = string.len_raw(rest)
    val rs: mut i64 = 0
    for {
        if rs >= rn {
            break
        }
        val c: u8 = @load8(@ptradd(rest, rs))
        if c != 32 && c != 9 {
            break
        }
        rs++
    }
    @store(out_rest, @ptradd(rest, rs))
    return util.copy_cstr_len(line, i)
}

fn print_help() void = trust {
    stdio.puts("Commands:")
    stdio.puts("  run, r [args...]       start / restart the program")
    stdio.puts("  continue, c            continue to the next breakpoint")
    stdio.puts("  next, n                step over (LLDB backend)")
    stdio.puts("  step, s                step into (LLDB backend)")
    stdio.puts("  finish, f              step out (LLDB backend)")
    stdio.puts("  break, b <func|file:line>")
    stdio.puts("  info break             list breakpoints")
    stdio.puts("  delete <id>            delete a breakpoint")
    stdio.puts("  locals, vars           show current local variables")
    stdio.puts("  print, p <expr>        evaluate an expression")
    stdio.puts("  watch <expr>           add an expression to the watch list")
    stdio.puts("  unwatch <n>            remove a watch expression")
    stdio.puts("  backtrace, bt          show the call stack")
    stdio.puts("  list [line]            show source around the current line")
    stdio.puts("  quit, q                quit")
}

type SourceVarInfo = {
    type_text: mut ref u8
    array_count: mut i64
}

fn source_trim(s: ref u8) ref u8 = trust {
    if s == none {
        return ""
    }
    val n: i64 = string.len_raw(s)
    val start: mut i64 = 0
    for {
        if start >= n {
            break
        }
        val c: u8 = @load8(@ptradd(s, start))
        if c == 32 || c == 9 || c == 10 || c == 13 {
            start++
        } else {
            break
        }
    }
    val end: mut i64 = n
    for {
        if end <= start {
            break
        }
        val c: u8 = @load8(@ptradd(s, end - 1))
        if c == 32 || c == 9 || c == 10 || c == 13 {
            end--
        } else {
            break
        }
    }
    return util.copy_cstr_len(@ptradd(s, start), end - start)
}

fn source_is_ident(c: u8) bool = trust {
    return (c >= 65 && c <= 90) || (c >= 97 && c <= 122) ||
    (c >= 48 && c <= 57) || c == 95
}

fn source_match_at(s: ref u8, pos: i64, needle: ref u8) bool = trust {
    val n: i64 = string.len_raw(s)
    val m: i64 = string.len_raw(needle)
    if pos < 0 || pos + m > n {
        return false
    }
    val i: mut i64 = 0
    for {
        if i >= m {
            break
        }
        if @load8(@ptradd(s, pos + i)) != @load8(@ptradd(needle, i)) {
            return false
        }
        i++
    }
    return true
}

fn source_skip_ws(s: ref u8, pos_in: i64) i64 = trust {
    val n: i64 = string.len_raw(s)
    val p: mut i64 = pos_in
    for {
        if p >= n {
            break
        }
        val c: u8 = @load8(@ptradd(s, p))
        if c == 32 || c == 9 || c == 10 || c == 13 {
            p++
        } else {
            break
        }
    }
    return p
}

fn source_count_elements(s: ref u8, start: i64) i64 = trust {
    val n: i64 = string.len_raw(s)
    val depth: mut i64 = 1
    val count: mut i64 = 0
    val has_item: mut bool = false
    val i: mut i64 = start
    for {
        if i >= n {
            break
        }
        val c: u8 = @load8(@ptradd(s, i))
        if c == 34 || c == 39 {
            has_item = true
            val quote: u8 = c
            i++
            for {
                if i >= n {
                    break
                }
                val d: u8 = @load8(@ptradd(s, i))
                if d == 92 {
                    i += 2
                    continue
                }
                i++
                if d == quote {
                    break
                }
            }
            continue
        }
        if c == 35 {
            for {
                if i >= n || @load8(@ptradd(s, i)) == 10 {
                    break
                }
                i++
            }
            continue
        }
        if c == 91 {
            depth++
            has_item = true
            i++
            continue
        }
        if c == 93 {
            depth--
            if depth == 0 {
                break
            }
            has_item = true
            i++
            continue
        }
        if c == 44 && depth == 1 {
            if has_item {
                count++
                has_item = false
            }
            i++
            continue
        }
        if c == 32 || c == 9 || c == 10 || c == 13 {
            i++
            continue
        }
        has_item = true
        i++
    }
    if has_item {
        count++
    }
    if depth != 0 {
        return -1
    }
    return count
}

fn source_var_info(file: ref u8, name: ref u8) SourceVarInfo = trust {
    val info: mut SourceVarInfo = {type_text: "", array_count: -1}
    if file == none || name == none ||
    string.len_raw(file) == 0 || string.len_raw(name) == 0 {
        return info
    }
    val data_opt = fs.read_all_raw(file)
    val data: mut ref u8 = none
    if data_opt is some dv {
        data = dv as ref u8
    } else {
        return info
    }
    val n: i64 = string.len_raw(data)
    val name_len: i64 = string.len_raw(name)
    val i: mut i64 = 0
    for {
        if i + name_len > n {
            break
        }
        if source_match_at(data, i, name) {
            val before_ok: bool = i == 0 || !source_is_ident(@load8(@ptradd(data, i - 1)))
            val after_i: i64 = i + name_len
            val after_ok: bool = after_i >= n || !source_is_ident(@load8(@ptradd(data, after_i)))
            if before_ok && after_ok {
                val p0: i64 = source_skip_ws(data, after_i)
                val p: mut i64 = p0
                val type_text: mut ref u8 = ""
                if p < n && @load8(@ptradd(data, p)) == 58 {
                    val ts: i64 = source_skip_ws(data, p + 1)
                    val te: mut i64 = ts
                    for {
                        if te >= n {
                            break
                        }
                        val c: u8 = @load8(@ptradd(data, te))
                        if c == 61 || c == 10 || c == 13 {
                            break
                        }
                        te++
                    }
                    type_text = source_trim(util.copy_cstr_len(@ptradd(data, ts), te - ts))
                    p = source_skip_ws(data, te)
                }
                if p < n && @load8(@ptradd(data, p)) == 61 {
                    info.type_text = type_text
                    val rhs: i64 = source_skip_ws(data, p + 1)
                    if rhs < n && @load8(@ptradd(data, rhs)) == 91 {
                        info.array_count = source_count_elements(data, rhs + 1)
                    }
                    return info
                }
            }
        }
        i++
    }
    return info
}

fn find_dwarf_var(t: ref target.Target, raw_name: ref u8) ref dwarf.DwarfVariable = trust {
    for v in t.dwarf_info.variables {
        if string.str_eql(v.name, raw_name) {
            return v
        }
    }
    return none
}

fn array_element_type(type_text: ref u8) ref u8 = trust {
    if string.len_raw(type_text) == 0 || @load8(type_text) != 91 {
        return ""
    }
    val rb: i64 = find_char(type_text, 0, 93)
    if rb < 0 {
        return ""
    }
    return source_trim(@ptradd(type_text, rb + 1))
}

fn value_u64(value: ref u8) option[u64] = trust {
    val v: ref u8 = source_trim(value)
    if string.len_raw(v) == 0 {
        return none
    }
    if string.raw_starts_with(v, "0x") || string.raw_starts_with(v, "0X") {
        return util.parse_u64_hex(v)
    }
    val iv_opt = util.parse_i64(v)
    if iv_opt is some iv {
        if iv < 0 {
            return none
        }
        return some (iv as u64)
    }
    return none
}

fn value_in_exec_section(t: ref target.Target, value: u64) bool = trust {
    // PIE targets report runtime addresses, so the link-time section ranges do
    // not apply directly.
    if t.elf_file.etype == 3 {
        return false
    }
    for sec in t.elf_file.sections {
        if (sec.flags & 4) == 0 || sec.size == 0 {
            continue
        }
        if value >= sec.addr && value < sec.addr + sec.size {
            return true
        }
    }
    return false
}

fn value_is_readable_pointer(t: ref target.Target, value: ref u8) bool = trust {
    val ptr_opt = value_u64(value)
    if ptr_opt is some ptr {
        if ptr < 4096 {
            return false
        }
        return !value_in_exec_section(t, ptr)
    }
    return false
}

fn print_locals_lldb(s: mut ref lldb.LldbSession, t: ref target.Target) void = trust {
    val vars: list[ref lldb.LldbVar] = lldb.parse_variables(lldb.clean_output(lldb.frame_variables(s)))
    if @len(vars) == 0 {
        stdio.puts("  (no locals)")
        return
    }
    for v in vars {
        val spectre: mut ref u8 = ""
        val array_count: mut i64 = -1
        val dv: ref dwarf.DwarfVariable = find_dwarf_var(t, v.raw_name)
        if dv != none {
            val info: SourceVarInfo = source_var_info(dv.file, v.name)
            if string.len_raw(info.type_text) > 0 {
                spectre = info.type_text
            }
            array_count = info.array_count
        }
        if string.len_raw(spectre) == 0 {
            spectre = lldb.spectre_type(v.type_name)
        }
        val value: mut ref u8 = v.value
        if array_count >= 0 && value_is_readable_pointer(t, v.value) {
            val elem_type: ref u8 = array_element_type(spectre)
            if string.len_raw(elem_type) > 0 {
                val elem_c: ref u8 = lldb.spectre_to_c_type(elem_type)
                if string.len_raw(elem_c) > 0 {
                    val array_value: ref u8 = lldb.read_array(
                        s, v.raw_name, elem_c, array_count
                    )
                    if string.len_raw(array_value) > 0 {
                        value = array_value
                    }
                }
            }
        }
        if string.len_raw(spectre) > 0 {
            stdio.print("  ({s} / {s}) {s} = {s}\n", {
                v.type_name, spectre, v.name, value
            })
        } else {
            stdio.print("  ({s}) {s} = {s}\n", {v.type_name, v.name, value})
        }
    }
}

fn print_watch_lldb(s: mut ref lldb.LldbSession, watches: list[ref u8]) void = trust {
    for w in watches {
        val expr: ref u8 = lldb.rewrite_expression(s, w)
        val out: ref u8 = lldb.clean_output(lldb.expression(s, expr))
        stdio.print("watch {s} = {s}\n", {w, trim_expr_result(out)})
    }
}

fn print_watch_native(s: ref native.NativeSession, watches: list[ref u8]) void = trust {
    for w in watches {
        val out: ref u8 = native.read_expression(s, w)
        if string.len_raw(out) == 0 {
            stdio.print("watch {s} = <unavailable>\n", {w})
        } else {
            stdio.print("watch {s} = {s}\n", {w, out})
        }
    }
}

fn trim_expr_result(out: ref u8) ref u8 = trust {
    // LLDB expression output is usually "(type) value". Keep the last line.
    val n: i64 = string.len_raw(out)
    val start: mut i64 = n
    for {
        if start <= 0 {
            break
        }
        if @load8(@ptradd(out, start - 1)) == 10 {
            if start < n {
                break
            }
            start--
            continue
        }
        start--
    }
    val line: ref u8 = util.copy_cstr_len(@ptradd(out, start), n - start)
    val rp: i64 = find_char(line, 0, 41)
    if rp >= 0 {
        val vs: mut i64 = rp + 1
        val ln: i64 = string.len_raw(line)
        for {
            if vs >= ln {
                break
            }
            val c: u8 = @load8(@ptradd(line, vs))
            if c != 32 && c != 9 {
                break
            }
            vs++
        }
        return util.copy_cstr_len(@ptradd(line, vs), ln - vs)
    }
    if string.len_raw(line) == 0 {
        return "<unavailable>"
    }
    return line
}

fn find_char(s: ref u8, start: i64, ch: u8) i64 = trust {
    val n: i64 = string.len_raw(s)
    val i: mut i64 = start
    for {
        if i >= n {
            return -1
        }
        if @load8(@ptradd(s, i)) == ch {
            return i
        }
        i++
    }
    return -1
}

fn print_lldb_stop(s: mut ref lldb.LldbSession) void = trust {
    if s.exited {
        stdio.print("Process exited with status {lld}\n", {s.exit_code})
        return
    }
    val frames: list[ref lldb.LldbFrame] = lldb.parse_frames(s.last_output)
    if @len(frames) == 0 {
        return
    }
    val f_opt = @get(frames, 0)
    if f_opt is none {
        return
    }
    val f: mut ref lldb.LldbFrame = none
    if f_opt is some fv {
        f = fv as ref lldb.LldbFrame
    }
    if f == none {
        return
    }
    if string.len_raw(f.file) > 0 {
        stdio.print("Stopped in {s} at {s}:{lld}\n", {
            f.function_display, util.basename(f.file), f.line
        })
        print_source_at(f.file, f.line)
    } else {
        stdio.print("Stopped in {s}\n", {f.function_display})
    }
}

fn print_native_stop(s: ref native.NativeSession) void = trust {
    if s.exited {
        stdio.print("Process exited with status {lld}\n", {s.exit_code})
        return
    }
    val loc: ref u8 = native.current_location(s)
    if string.len_raw(loc) > 0 {
        stdio.print("Stopped in {s} at {s}\n", {native.current_function_name(s), util.basename(loc)})
        val colon: i64 = last_colon(loc)
        if colon > 0 {
            val line_opt = util.parse_i64(@ptradd(loc, colon + 1))
            if line_opt is some line {
                print_source_at(util.copy_cstr_len(loc, colon), line)
            }
        }
    } else {
        stdio.print("Stopped in {s}\n", {native.current_function_name(s)})
    }
}

fn last_colon(s: ref u8) i64 = trust {
    val n: i64 = string.len_raw(s)
    val i: mut i64 = n - 1
    for {
        if i < 0 {
            break
        }
        if @load8(@ptradd(s, i)) == 58 {
            return i
        }
        i--
    }
    return -1
}

fn print_source_at(file: ref u8, line: i64) void = trust {
    val data_opt = fs.read_all_raw(file)
    val data: mut ref u8 = none
    if data_opt is some dv {
        data = dv as ref u8
    } else {
        return
    }
    val n: i64 = string.len_raw(data)
    val cur: mut i64 = 1
    val pos: mut i64 = 0
    for {
        if pos >= n {
            break
        }
        val end: mut i64 = pos
        for {
            if end >= n || @load8(@ptradd(data, end)) == 10 {
                break
            }
            end++
        }
        if cur >= line - 2 && cur <= line + 2 {
            val marker: mut ref u8 = "  "
            if cur == line {
                marker = "> "
            }
            stdio.print("{s}{lld}: {s}\n", {marker, cur, util.copy_cstr_len(@ptradd(data, pos), end - pos)})
        }
        if cur > line + 2 {
            break
        }
        cur++
        pos = end + 1
    }
}

fn set_lldb_breakpoint(
    s: mut ref lldb.LldbSession,
    t: ref target.Target,
    query: ref u8
) void = trust {
    val colon: i64 = last_colon(query)
    if colon > 0 {
        val line_opt = util.parse_i64(@ptradd(query, colon + 1))
        if line_opt is some line {
            val file: ref u8 = util.copy_cstr_len(query, colon)
            val out: ref u8 = lldb.clean_output(lldb.breakpoint_file_line(s, file, line))
            stdio.print("{s}\n", {out})
            return
        }
    }
    val raw: ref u8 = target.function_raw(t, query)
    val name: mut ref u8 = raw
    if string.len_raw(name) == 0 {
        name = query
    }
    val out2: ref u8 = lldb.clean_output(lldb.breakpoint_symbol(s, name))
    stdio.print("{s}\n", {out2})
}

fn exec_lldb_command(
    s: mut ref lldb.LldbSession,
    t: ref target.Target,
    cmd: ref u8,
    rest: ref u8,
    watches: mut list[ref u8],
    startup_args: list[ref u8]
) bool = trust {
    if string.str_eql(cmd, "quit") || string.str_eql(cmd, "q") || string.str_eql(cmd, "exit") {
        lldb.quit(s)
        return true
    } elif string.str_eql(cmd, "help") || string.str_eql(cmd, "h") {
        print_help()
    } elif string.str_eql(cmd, "run") || string.str_eql(cmd, "r") {
        val args: list[ref u8] = split_args(rest)
        val final_args: mut list[ref u8] = args
        if @len(args) == 0 {
            final_args = startup_args
        }
        lldb.run(s, final_args)
        print_lldb_stop(s)
        print_watch_lldb(s, watches)
    } elif string.str_eql(cmd, "continue") || string.str_eql(cmd, "c") {
        lldb.cont(s)
        print_lldb_stop(s)
        print_watch_lldb(s, watches)
    } elif string.str_eql(cmd, "next") || string.str_eql(cmd, "n") {
        lldb.next(s)
        print_lldb_stop(s)
        print_watch_lldb(s, watches)
    } elif string.str_eql(cmd, "step") || string.str_eql(cmd, "s") {
        lldb.step(s)
        print_lldb_stop(s)
        print_watch_lldb(s, watches)
    } elif string.str_eql(cmd, "finish") || string.str_eql(cmd, "f") {
        lldb.finish(s)
        print_lldb_stop(s)
        print_watch_lldb(s, watches)
    } elif string.str_eql(cmd, "break") || string.str_eql(cmd, "b") {
        if string.len_raw(rest) > 0 {
            set_lldb_breakpoint(s, t, rest)
        }
    } elif string.str_eql(cmd, "info") {
        if string.raw_starts_with(rest, "break") || string.raw_starts_with(rest, "b") {
            stdio.print("{s}\n", {lldb.clean_output(lldb.list_breakpoints(s))})
        } else {
            stdio.puts("usage: info break")
        }
    } elif string.str_eql(cmd, "delete") || string.str_eql(cmd, "d") {
        val id_opt = util.parse_i64(rest)
        if id_opt is some id {
            stdio.print("{s}\n", {lldb.clean_output(lldb.delete_breakpoint(s, id))})
        } else {
            stdio.puts("usage: delete <id>")
        }
    } elif string.str_eql(cmd, "locals") || string.str_eql(cmd, "vars") || string.str_eql(cmd, "l") {
        print_locals_lldb(s, t)
    } elif string.str_eql(cmd, "print") || string.str_eql(cmd, "p") {
        val expr: ref u8 = lldb.rewrite_expression(s, rest)
        val out: ref u8 = lldb.clean_output(lldb.expression(s, expr))
        stdio.print("{s}\n", {out})
    } elif string.str_eql(cmd, "watch") {
        if string.len_raw(rest) > 0 {
            @append(watches, util.copy_cstr(rest))
            print_watch_lldb(s, watches)
        }
    } elif string.str_eql(cmd, "unwatch") {
        val idx_opt = util.parse_i64(rest)
        if idx_opt is some idx {
            val ii: i64 = idx
            if ii > 0 && ii <= (@len(watches) as i64) {
                @remove(watches, (ii - 1) as usize)
            }
        }
    } elif string.str_eql(cmd, "backtrace") || string.str_eql(cmd, "bt") {
        stdio.print("{s}\n", {lldb.clean_output(lldb.backtrace(s, 32))})
    } elif string.str_eql(cmd, "list") {
        val line_opt = util.parse_i64(rest)
        if line_opt is some line {
            stdio.print("{s}\n", {lldb.clean_output(lldb.source_line(s, line))})
        } else {
            stdio.print("{s}\n", {lldb.clean_output(lldb.source_line(s, 0))})
        }
    } else {
        stdio.print("phantom: unknown command '{s}'\n", {cmd})
    }
    return false
}

fn run_lldb(
    t: ref target.Target,
    program: ref u8,
    startup_args: list[ref u8],
    batch: bool,
    commands: list[ref u8]
) i32 = trust {
    val s_opt = lldb.new("lldb", program)
    val s: mut ref lldb.LldbSession = none
    match s_opt {
        err e => {
            stdio.print("phantom: {s}\n", {e})
            return 1
        }
        ok sv => {
            s = sv
        }
    }
    val watches: mut list[ref u8] = @listalloc[allocators.HeapAllocator, ref u8](util.heap())?
    if batch {
        if (@len(commands) as i64) > 0 {
            for line in commands {
                if string.len_raw(line) == 0 {
                    continue
                }
                val rest: mut ref u8 = ""
                val cmd: ref u8 = split_word(line, @addr(rest))
                if exec_lldb_command(s, t, cmd, rest, watches, startup_args) {
                    break
                }
            }
        } else {
            for {
                val line: ref u8 = read_command()
                if string.len_raw(line) == 0 {
                    break
                }
                val rest: mut ref u8 = ""
                val cmd: ref u8 = split_word(line, @addr(rest))
                if exec_lldb_command(s, t, cmd, rest, watches, startup_args) {
                    break
                }
            }
        }
        lldb.quit(s)
        return 0
    }
    stdio.print("Phantom (LLDB backend) - {s}\n", {program})
    stdio.puts("Type 'help' for commands. 'run' starts the program.")
    for {
        stdio.print("(phantom) ", {})
        val line: ref u8 = read_command()
        if string.len_raw(line) == 0 {
            if s.exited {
                break
            }
            continue
        }
        val rest: mut ref u8 = ""
        val cmd: ref u8 = split_word(line, @addr(rest))
        if exec_lldb_command(s, t, cmd, rest, watches, startup_args) {
            break
        }
    }
    return 0
}

fn split_args(rest: ref u8) list[ref u8] = trust {
    val out: mut list[ref u8] = @listalloc[allocators.HeapAllocator, ref u8](util.heap())?
    val n: i64 = string.len_raw(rest)
    val i: mut i64 = 0
    for {
        if i >= n {
            break
        }
        val c: u8 = @load8(@ptradd(rest, i))
        if c == 32 || c == 9 {
            i++
            continue
        }
        val start: i64 = i
        for {
            if i >= n {
                break
            }
            val d: u8 = @load8(@ptradd(rest, i))
            if d == 32 || d == 9 {
                break
            }
            i++
        }
        @append(out, util.copy_cstr_len(@ptradd(rest, start), i - start))
    }
    return out
}

fn exec_native_command(
    s: mut ref native.NativeSession,
    cmd: ref u8,
    rest: ref u8,
    watches: mut list[ref u8],
    startup_args: list[ref u8]
) bool = trust {
    if string.str_eql(cmd, "quit") || string.str_eql(cmd, "q") || string.str_eql(cmd, "exit") {
        native.quit(s)
        return true
    } elif string.str_eql(cmd, "help") || string.str_eql(cmd, "h") {
        print_help()
    } elif string.str_eql(cmd, "run") || string.str_eql(cmd, "r") {
        if s.started && !s.exited {
            native.cont(s)
        } else {
            val args: list[ref u8] = split_args(rest)
            val final_args: mut list[ref u8] = args
            if @len(args) == 0 {
                final_args = startup_args
            }
            val lr = native.launch(s, final_args)
            match lr {
                err e => {
                    stdio.print("phantom: {s}\n", {e})
                    return false
                }
                ok _ => {
                    native.cont(s)
                }
            }
        }
        print_native_stop(s)
        print_watch_native(s, watches)
    } elif string.str_eql(cmd, "continue") || string.str_eql(cmd, "c") {
        val cr = native.cont(s)
        match cr {
            err e => {
                stdio.print("phantom: {s}\n", {e})
                return false
            }
            ok _ => {
                print_native_stop(s)
                print_watch_native(s, watches)
            }
        }
    } elif string.str_eql(cmd, "next") || string.str_eql(cmd, "n") ||
    string.str_eql(cmd, "step") || string.str_eql(cmd, "s") ||
    string.str_eql(cmd, "finish") || string.str_eql(cmd, "f") {
        stdio.puts("phantom: source-level stepping is not implemented in the native backend yet; use the LLDB backend for now.")
    } elif string.str_eql(cmd, "break") || string.str_eql(cmd, "b") {
        if string.len_raw(rest) > 0 {
            val addr_opt = native.resolve_breakpoint(s, rest)
            if addr_opt is some addr {
                val id: i64 = native.add_breakpoint(s, addr, rest, "source")
                stdio.print("Breakpoint {lld}: {s} at 0x{x}\n", {id, rest, addr})
            } else {
                stdio.print("phantom: no breakpoint location matching '{s}'\n", {rest})
            }
        }
    } elif string.str_eql(cmd, "info") {
        if string.raw_starts_with(rest, "break") || string.raw_starts_with(rest, "b") {
            stdio.print("{s}", {native.list_breakpoints(s)})
        } else {
            stdio.puts("usage: info break")
        }
    } elif string.str_eql(cmd, "delete") || string.str_eql(cmd, "d") {
        val id_opt = util.parse_i64(rest)
        if id_opt is some id {
            if native.delete_breakpoint(s, id) {
                stdio.print("Deleted breakpoint {lld}\n", {id})
            } else {
                stdio.print("phantom: no breakpoint {lld}\n", {id})
            }
        } else {
            stdio.puts("usage: delete <id>")
        }
    } elif string.str_eql(cmd, "locals") || string.str_eql(cmd, "vars") || string.str_eql(cmd, "l") {
        stdio.print("{s}", {native.locals(s)})
    } elif string.str_eql(cmd, "print") || string.str_eql(cmd, "p") {
        val out: ref u8 = native.read_expression(s, rest)
        if string.len_raw(out) == 0 {
            stdio.puts("phantom: cannot evaluate expression")
        } else {
            stdio.print("{s}\n", {out})
        }
    } elif string.str_eql(cmd, "watch") {
        if string.len_raw(rest) > 0 {
            @append(watches, util.copy_cstr(rest))
            print_watch_native(s, watches)
        }
    } elif string.str_eql(cmd, "unwatch") {
        val idx_opt = util.parse_i64(rest)
        if idx_opt is some idx {
            val ii: i64 = idx
            if ii > 0 && ii <= (@len(watches) as i64) {
                @remove(watches, (ii - 1) as usize)
            }
        }
    } elif string.str_eql(cmd, "backtrace") || string.str_eql(cmd, "bt") {
        stdio.print("{s}", {native.backtrace(s)})
    } elif string.str_eql(cmd, "list") {
        val loc: ref u8 = native.current_location(s)
        val colon: i64 = last_colon(loc)
        if colon > 0 {
            val line_opt = util.parse_i64(@ptradd(loc, colon + 1))
            if line_opt is some line {
                print_source_at(util.copy_cstr_len(loc, colon), line)
            }
        }
    } else {
        stdio.print("phantom: unknown command '{s}'\n", {cmd})
    }
    return false
}

fn run_native(
    program: ref u8,
    startup_args: list[ref u8],
    batch: bool,
    commands: list[ref u8]
) i32 = trust {
    val arena: allocators.Arena = allocators.Arena.new(64 * 1024 * 1024 as usize)?
    val n_opt = native.load(arena, program)
    val s: mut ref native.NativeSession = none
    match n_opt {
        err e => {
            stdio.print("phantom: {s}\n", {e})
            return 1
        }
        ok sv => {
            s = sv
        }
    }
    val watches: mut list[ref u8] = @listalloc[allocators.HeapAllocator, ref u8](util.heap())?
    if batch {
        if (@len(commands) as i64) > 0 {
            for line in commands {
                if string.len_raw(line) == 0 {
                    continue
                }
                val rest: mut ref u8 = ""
                val cmd: ref u8 = split_word(line, @addr(rest))
                if exec_native_command(s, cmd, rest, watches, startup_args) {
                    break
                }
            }
        } else {
            for {
                val line: ref u8 = read_command()
                if string.len_raw(line) == 0 {
                    break
                }
                val rest: mut ref u8 = ""
                val cmd: ref u8 = split_word(line, @addr(rest))
                if exec_native_command(s, cmd, rest, watches, startup_args) {
                    break
                }
            }
        }
        native.quit(s)
        return 0
    }
    stdio.print("Phantom (native DWARF/ptrace backend) - {s}\n", {program})
    stdio.puts("Type 'help' for commands. Stepping is currently LLDB-only.")
    for {
        stdio.print("(phantom) ", {})
        val line: ref u8 = read_command()
        if string.len_raw(line) == 0 {
            if s.exited {
                break
            }
            continue
        }
        val rest: mut ref u8 = ""
        val cmd: ref u8 = split_word(line, @addr(rest))
        if exec_native_command(s, cmd, rest, watches, startup_args) {
            break
        }
    }
    return 0
}

/// Run the interactive debugger or a non-interactive batch of commands.
pub fn run(
    t: ref target.Target,
    program: ref u8,
    backend: ref u8,
    args: list[ref u8],
    batch: bool,
    commands: list[ref u8]
) i32 = trust {
    if string.str_eql(backend, "native") || string.str_eql(backend, "dwarf") ||
    string.str_eql(backend, "ptrace") {
        return run_native(program, args, batch, commands)
    }
    return run_lldb(t, program, args, batch, commands)
}

test "counts fixed array literal elements" {
    trust {
        assert source_count_elements("[\"a\", \"b\", [1, 2], \"c\"]", 1) == 4
        assert source_count_elements("[1, 2, 3]", 1) == 3
        assert source_count_elements("[]", 1) == 0
    }
}

test "extracts array element types" {
    trust {
        assert string.str_eql(array_element_type("[_]ref u8"), "ref u8")
        assert string.str_eql(array_element_type("i64"), "")
    }
}

test "reads source variable types and array lengths" {
    trust {
        val dir: ref u8 = fs.temp_dir_raw()
        val path: ref u8 = @fmtalloc("{s}/phantom-source-test.sx", {dir})
        assert fs.write_all(
            path,
            "val xs: [_]ref u8 = [\n    \"a\", \"b\", [1, 2], \"c\"\n]\n"
        )
        val info: SourceVarInfo = source_var_info(path, "xs")
        assert string.str_eql(info.type_text, "[_]ref u8")
        assert info.array_count == 4
        fs.delete(path)
    }
}
